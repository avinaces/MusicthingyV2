<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:test="clr-namespace:Musicthingy.TestModels"
    x:Class="Musicthingy.UltimateTestPage"
    x:DataType="test:UltimateViewModel"
    BackgroundColor="{StaticResource BgColor}">
    <!-- Force Dark Background -->

    <!-- INJECTED YOUR RESOURCES TO REPLICATE THE BUG -->
    <ContentPage.Resources>
        <Color x:Key="BgColor">#0d1117</Color>
        <Color x:Key="TextColor">#c9d1d9</Color>
        <Color x:Key="MutedColor">#8b949e</Color>

        <!-- THIS IMPLICIT STYLE FAILS TO REACH DATATEMPLATES -->
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <test:UltimateViewModel/>
    </ContentPage.BindingContext>

    <Grid ColumnDefinitions="260,*" Padding="16" ColumnSpacing="24">

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#161b22" Stroke="Gray" StrokeThickness="1" Padding="12">
            <Grid RowDefinitions="Auto,*">

                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <!-- This text is OUTSIDE the DataTemplate, so it WILL render fine -->
                    <Label Text="Playlists" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                </Grid>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Playlists}" SelectionMode="Single" SelectedItem="{Binding SelectedPlaylist}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="test:UltimatePlaylist">
                            <Border StrokeShape="RoundRectangle 12" Padding="10" Background="#1c2128">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">

                                    <!-- BUG 1: Implicit Style Fails. Text turns Black/Invisible on dark background -->
                                    <Label Grid.Row="1" Text="{Binding Name}" HorizontalTextAlignment="Center" FontAttributes="Bold"/>

                                    <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="6">
                                        <!-- BUG 2: StaticResource fails inside template. Text turns Transparent -->
                                        <Border Padding="8,2">
                                            <Label Text="StaticResource Fail" TextColor="{StaticResource MutedColor}"/>
                                        </Border>

                                        <!-- THE FIX: DynamicResource forces the template to find the color -->
                                        <Border Padding="8,2">
                                            <Label Text="DynamicResource Fix" TextColor="{DynamicResource MutedColor}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" Stroke="Gray" StrokeThickness="1" Padding="16">

            <Grid RowDefinitions="Auto,Auto,*">

                <!-- header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

                    <Label
Text="{Binding SelectedPlaylist.Name}"
FontSize="24"
FontAttributes="Bold"/>

                    <VerticalStackLayout Grid.Column="1">

                        <Label Text="{Binding SelectedPlaylist.ItemCount, StringFormat='{0} items'}"/>
                        <Label Text="00:00"/>

                    </VerticalStackLayout>

                </Grid>

                <!-- controls -->
                <HorizontalStackLayout Grid.Row="1" Spacing="8">

                    <Button Text="Play"/>
                    <Button Text="Add"/>
                    <Button Text="Paste"/>

                </HorizontalStackLayout>

                <!-- track list -->
                <CollectionView
Grid.Row="2"
ItemsSource="{Binding SelectedPlaylist.Items}"
ItemSizingStrategy="MeasureAllItems">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>

                        <DataTemplate x:DataType="test:UltimateItem">

                            <Border Padding="10">

                                <Grid ColumnDefinitions="Auto,*,Auto">

                                    <Image
Grid.Column="0"
Source="dotnet_bot.png"
HeightRequest="36"
WidthRequest="36"/>

                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto">

                                        <Label
Grid.Row="0"
Text="{Binding Title}"
FontAttributes="Bold"/>

                                        <!-- track list -> CollectionView -> ItemTemplate -> Grid -> FlexLayout -->

                                        <FlexLayout Grid.Row="1" BindableLayout.ItemsSource="{Binding Tags}" Direction="Row" Wrap="Wrap">
                                            <BindableLayout.ItemTemplate>
                                                <!-- ADD x:DataType="x:String" HERE -->
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Padding="8,2">
                                                        <!-- Use {Binding .} to refer to the string itself -->
                                                        <Label Text="{Binding .}" FontSize="11"/>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>

                                    </Grid>

                                    <HorizontalStackLayout Grid.Column="2">

                                        <Button Text="E"/>
                                        <Button Text="X"/>

                                    </HorizontalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Border>

    </Grid>

</ContentPage>