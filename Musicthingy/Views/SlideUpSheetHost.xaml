<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musicthingy.Views.SlideUpSheetHost"
             IsVisible="False">
    <Grid>
        <!-- The tappable dim background -->
        <BoxView x:Name="Backdrop" BackgroundColor="{DynamicResource SurfaceScrim}" Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- The Grid that holds unlimited stacked sheets -->
        <Grid x:Name="SheetContainer" VerticalOptions="End" />
    </Grid>
</ContentView>
