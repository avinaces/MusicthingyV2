<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Musicthingy.Helpers"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Musicthingy.Views.SettingsCategoryPage"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Top Bar -->
        <Grid Grid.Row="0" HeightRequest="56" BackgroundColor="{DynamicResource BgColor}" ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ImageButton Grid.Column="0" Source="arrow_left_icon.png" Clicked="OnBackClicked" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="Transparent" Padding="8">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                </ImageButton.Behaviors>
            </ImageButton>

            <Label x:Name="TitleLabel" Grid.Column="1" TextColor="{DynamicResource TitleColor}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
        </Grid>

        <!-- CUSTOM STORAGE UI (Only visible for Storage category) -->
        <Border x:Name="StorageStatsContainer" Grid.Row="1" IsVisible="False" Margin="16,8,16,16" Padding="16" BackgroundColor="{DynamicResource SurfacePanel}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="12">
                <Label Text="Cache Statistics" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TitleColor}"/>

                <ProgressBar x:Name="StorageProgressBar" Progress="0" ProgressColor="{DynamicResource AccentColor}" HeightRequest="8"/>

                <Grid ColumnDefinitions="*,*">
                    <Label x:Name="UsedStorageLabel" Grid.Column="0" TextColor="{DynamicResource MutedColor}" FontSize="12"/>
                    <Label x:Name="MaxStorageLabel" Grid.Column="1" HorizontalOptions="End" TextColor="{DynamicResource MutedColor}" FontSize="12"/>
                </Grid>

                <!-- Download Progress (only visible while downloading) -->
                <Border x:Name="DownloadProgressContainer" IsVisible="False" Margin="0,4,0,4" Padding="12" BackgroundColor="{DynamicResource BgColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" x:Name="DownloadUrlLabel" TextColor="{DynamicResource TextColor}" FontSize="12" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="1" x:Name="DownloadSpeedLabel" TextColor="{DynamicResource MutedColor}" FontSize="12" HorizontalOptions="End" />
                        </Grid>
                        <ProgressBar x:Name="DownloadProgressBar" Progress="0" ProgressColor="{DynamicResource AccentColor}" HeightRequest="4"/>
                        <Label x:Name="DownloadSizeLabel" TextColor="{DynamicResource MutedColor}" FontSize="11"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Clear Cache Now" Clicked="OnClearCacheClicked" BackgroundColor="{DynamicResource DangerColor}" TextColor="White" CornerRadius="8" HeightRequest="40" Margin="0,8,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Settings List -->
        <CollectionView Grid.Row="2" x:Name="SettingsList">
            <CollectionView.ItemTemplate>
                <helpers:SettingsTemplateSelector />
            </CollectionView.ItemTemplate>

            <!-- CUSTOM PLAYBACK DIAGNOSTICS (Only visible for Playback category) -->
            <CollectionView.Footer>
                <Border x:Name="PlaybackDiagnosticsContainer" IsVisible="False"
                        Margin="16,4,16,16" Padding="0"
                        BackgroundColor="{DynamicResource SurfacePanel}"
                        Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="0">

                        <!-- Header: icon + track + live status -->
                        <Grid Padding="16,14,16,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Center"
                                    BackgroundColor="{DynamicResource AccentContainer}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Image Source="music_4_icon.png" WidthRequest="19" HeightRequest="19"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{DynamicResource AccentColor}" />
                                    </Image.Behaviors>
                                </Image>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="DiagTrackTitleLabel" Text="Nothing playing" FontSize="14"
                                       FontAttributes="Bold" TextColor="{DynamicResource TitleColor}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label x:Name="DiagTrackSubtitleLabel" Text="Technical playback details" FontSize="11"
                                       TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Border x:Name="DiagCacheBadge" IsVisible="False" Padding="8,4"
                                        BackgroundColor="{DynamicResource TagBgColor}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20">
                                    <Label Text="CACHED" FontSize="9" FontAttributes="Bold"
                                           TextColor="{DynamicResource TagTextColor}" CharacterSpacing="1" />
                                </Border>

                                <Border x:Name="DiagStatusBorder" Padding="9,4" VerticalOptions="Center"
                                        BackgroundColor="{DynamicResource SurfaceRaised}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20">
                                    <Label x:Name="DiagStatusLabel" Text="IDLE" FontSize="9" FontAttributes="Bold"
                                           TextColor="{DynamicResource MutedColor}" CharacterSpacing="1" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" Margin="16,0" />

                        <!-- Live technical details -->
                        <VerticalStackLayout x:Name="DiagDetailsContainer" Padding="16,12,16,14" Spacing="12">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="12" RowSpacing="10">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="1">
                                    <Label Text="FORMAT" FontSize="9" CharacterSpacing="1" TextColor="{DynamicResource MutedColor}" />
                                    <Label x:Name="DiagFormatValue" Text="—" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="1">
                                    <Label Text="STREAM" FontSize="9" CharacterSpacing="1" TextColor="{DynamicResource MutedColor}" />
                                    <Label x:Name="DiagStreamValue" Text="—" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="1">
                                    <Label Text="CLIENT" FontSize="9" CharacterSpacing="1" TextColor="{DynamicResource MutedColor}" />
                                    <Label x:Name="DiagClientValue" Text="—" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="1">
                                    <Label Text="SAMPLE RATE" FontSize="9" CharacterSpacing="1" TextColor="{DynamicResource MutedColor}" />
                                    <Label x:Name="DiagSampleRateValue" Text="—" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="1">
                                    <Label Text="BITRATE" FontSize="9" CharacterSpacing="1" TextColor="{DynamicResource MutedColor}" />
                                    <Label x:Name="DiagBitrateValue" Text="—" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="1">
                                    <Label Text="ITAG" FontSize="9" CharacterSpacing="1" TextColor="{DynamicResource MutedColor}" />
                                    <Label x:Name="DiagItagValue" Text="—" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Buffer progress -->
                            <Border BackgroundColor="{DynamicResource BgColor}" Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="BUFFER" FontSize="9" CharacterSpacing="1" TextColor="{DynamicResource MutedColor}" />
                                        <Label Grid.Column="1" x:Name="DiagBufferPercentLabel" Text="0%" FontSize="10" FontAttributes="Bold" TextColor="{DynamicResource AccentColor}" HorizontalOptions="End" />
                                    </Grid>
                                    <ProgressBar x:Name="DiagBufferBar" Progress="0" ProgressColor="{DynamicResource AccentColor}" HeightRequest="6" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" x:Name="DiagPositionLabel" Text="0:00 / 0:00" FontSize="10" TextColor="{DynamicResource TextColor}" />
                                        <Label Grid.Column="1" x:Name="DiagBufferLabel" Text="Buffered 0:00" FontSize="10" TextColor="{DynamicResource MutedColor}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Label x:Name="DiagDetailLabel" Text="" FontSize="10" TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>

                        <!-- Empty state -->
                        <Label x:Name="DiagEmptyLabel" IsVisible="False" Text="Play something to see live stream details."
                               Padding="16,10,16,18" FontSize="12" TextColor="{DynamicResource MutedColor}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>