<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musicthingy.Views.SegmentedTabBar">

    <Border BackgroundColor="{DynamicResource SurfaceInput}" 
            Stroke="{DynamicResource BorderColor}" 
            StrokeThickness="1" 
            StrokeShape="RoundRectangle 12" 
            Padding="4" 
            HeightRequest="48">

        <Grid>
            <!-- The single moving pill indicator -->
            <Border x:Name="ActiveIndicator" 
                    BackgroundColor="{DynamicResource TabIndicatorColor}" 
                    StrokeThickness="0" 
                    StrokeShape="RoundRectangle 8" 
                    HorizontalOptions="Start" />

            <Grid x:Name="MainGrid" SizeChanged="OnMainGridSizeChanged" />
        </Grid>

    </Border>

</ContentView>