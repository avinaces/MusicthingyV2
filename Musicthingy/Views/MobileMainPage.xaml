<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Musicthingy.Models"
             xmlns:views="clr-namespace:Musicthingy.Views"
             xmlns:viewmodels="clr-namespace:Musicthingy.ViewModels"
             xmlns:mpowerkit="clr-namespace:MPowerKit.VirtualizeListView;assembly=MPowerKit.VirtualizeListView"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Musicthingy.Views.MobileMainPage"
             x:Name="RootPage"
             BackgroundColor="{DynamicResource BgColor}">

    <!-- Define the reusable Toolbar Template -->
    <ContentPage.Resources>
        <ControlTemplate x:Key="SharedToolbarTemplate">
            <Grid BackgroundColor="{DynamicResource BgColor}">
                <Grid Margin="16,0" ColumnDefinitions="Auto, *">

                    <!-- SORTING CONTROLS -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">

                        <!-- 1. Sort Direction Arrow -->
                        <ImageButton Source="{Binding SortDirectionIcon}" 
                                     Command="{Binding ToggleSortDirectionCommand}" 
                                     IsVisible="{Binding IsDirectionToggleVisible}"
                                     WidthRequest="48" HeightRequest="48" 
                                     Padding="12"
                                     CornerRadius="24"
                                     BackgroundColor="Transparent"
                                     VerticalOptions="Center">
                            <ImageButton.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{Binding BindingContext.TextColor, Source={x:Reference RootPage}}" />
                            </ImageButton.Behaviors>
                        </ImageButton>

                        <!-- 2. Sort Field Picker Button -->
                        <Border BackgroundColor="Transparent" Stroke="Transparent" Padding="0,8" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSortOptionsClicked" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Image Source="list_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" IsVisible="{Binding IsSortCustom}">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{DynamicResource TextColor}" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Text="{Binding CurrentSortModeText}" TextColor="{DynamicResource TextColor}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" HorizontalOptions="End">

                        <!-- FILTER CONTROLS -->
                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center">

                            <!-- The Text: ALWAYS opens the sheet, so you can still edit active filters -->
                            <ContentView Padding="0,8" VerticalOptions="Center">
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenFilterSheetCommand}" />
                                </ContentView.GestureRecognizers>
                                <Label Text="Filter" TextColor="{Binding FilterIconColor}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            </ContentView>

                            <!-- The Icon: Clears filter when active, opens sheet when inactive -->
                            <ImageButton Source="{Binding FilterToolbarIcon}" 
                                         Command="{Binding ToolbarFilterIconActionCommand}"
                                         WidthRequest="48" HeightRequest="48"
                                         Padding="12"
                                         CornerRadius="24"
                                         BackgroundColor="Transparent"
                                         VerticalOptions="Center">
                                <ImageButton.Behaviors>
                                    <!-- Explicitly route the BindingContext using the RootPage reference -->
                                    <toolkit:IconTintColorBehavior TintColor="{Binding BindingContext.FilterIconColor, Source={x:Reference RootPage}}" />
                                </ImageButton.Behaviors>
                            </ImageButton>

                        </HorizontalStackLayout>

                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto, *">
            <!-- Custom Navigation Bar -->
            <Grid Grid.Row="0" HeightRequest="56" BackgroundColor="{DynamicResource BgColor}" ZIndex="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentView Grid.Column="0" VerticalOptions="Fill" HorizontalOptions="Fill">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHamburgerTapped" />
                    </ContentView.GestureRecognizers>
                    <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Fill="{DynamicResource TitleColor}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="24" HeightRequest="24" />
                </ContentView>

                <Label Grid.Column="1" Text="{Binding SelectedPlaylist.Name}" TextColor="{DynamicResource TitleColor}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>

            <!-- Detail Grid (Tracks + Bottom Player) -->
            <Grid Grid.Row="1" RowDefinitions="*, Auto">
                <Grid Grid.Row="0">
                    <mpowerkit:VirtualizeListView x:Name="TracksListView" 
                                                  ItemsSource="{Binding DisplayedItems}" 
                                                  Scrolled="OnListScrolled"
                                                  Header="{Binding .}">

                        <mpowerkit:VirtualizeListView.HeaderTemplate>
                            <DataTemplate x:DataType="viewmodels:MainViewModel">
                                <VerticalStackLayout HorizontalOptions="Fill">

                                    <VerticalStackLayout SizeChanged="OnPlaylistInfoSizeChanged" Padding="16,16,16,16" Spacing="12">

                                        <Image Source="{Binding SelectedPlaylist.IconImageSource}" WidthRequest="220" HeightRequest="220" Aspect="AspectFill" HorizontalOptions="Center">
                                            <Image.Clip>
                                                <RoundRectangleGeometry CornerRadius="16" Rect="0,0,220,220" />
                                            </Image.Clip>
                                        </Image>

                                        <Label Text="{Binding SelectedPlaylist.Name}" TextColor="{DynamicResource TitleColor}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="0,6,0,0"/>

                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                            <Label Text="{Binding SelectedPlaylist.CreatedAt, StringFormat='{0:yyyy}'}" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                            <Label Text="•" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                            <Label Text="{Binding SelectedPlaylist.ItemCount, StringFormat='{0} tracks'}" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                            <Label Text="•" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                            <Label Text="{Binding SelectedPlaylist.DisplayDuration}" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                        </HorizontalStackLayout>

                                        <Grid ColumnDefinitions="*, *, 48" ColumnSpacing="8" Margin="8,8,8,0">
                                            <ImageButton Grid.Column="0" Source="play_icon.png" Command="{Binding PlayPlaylistCommand}" HeightRequest="48" HorizontalOptions="Fill" CornerRadius="24" BackgroundColor="{DynamicResource CardColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" Padding="12" />
                                            <ImageButton Grid.Column="1" Source="shuffle_icon.png" Command="{Binding ShufflePlaylistCommand}" HeightRequest="48" HorizontalOptions="Fill" CornerRadius="24" BackgroundColor="{DynamicResource CardColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" Padding="12" />
                                            <ImageButton Grid.Column="2" Source="ellipsis_vertical_icon.png" BindingContext="{Binding SelectedPlaylist}" Clicked="OnPlaylistOptionsClicked" WidthRequest="48" HeightRequest="48" CornerRadius="24" BackgroundColor="{DynamicResource CardColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" Padding="12" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <!-- NATIVE INLINE TOOLBAR (Changed HeightRequest to 48) -->
                                    <Grid HeightRequest="48">
                                        <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" VerticalOptions="Start" ZIndex="1" />
                                        <ContentView ControlTemplate="{StaticResource SharedToolbarTemplate}" />
                                    </Grid>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </mpowerkit:VirtualizeListView.HeaderTemplate>

                        <mpowerkit:VirtualizeListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistItem">
                                <mpowerkit:VirtualizeListViewCell>
                                    <Grid Margin="12,0,12,4" HeightRequest="58">
                                        <Border StrokeShape="RoundRectangle 8" Padding="0" Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Padding="7" BackgroundColor="Transparent">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTrackTapped" />
                                                </Grid.GestureRecognizers>

                                                <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                                    <Image Source="{Binding ItemIconSource}" Aspect="AspectFill">
                                                        <Image.Clip>
                                                            <RoundRectangleGeometry CornerRadius="7" Rect="0,0,44,44" />
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>

                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                    <Grid HeightRequest="24" IsClippedToBounds="True">
                                                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                                            <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag1}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding Tag1}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag2}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding Tag2}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag3}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding Tag3}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag4}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding Tag4}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </VerticalStackLayout>

                                                <ImageButton Grid.Column="2" Source="ellipsis_vertical_icon.png" Clicked="OnTrackOptionsClicked" VerticalOptions="Center" HorizontalOptions="End" WidthRequest="44" HeightRequest="44" Padding="12" BackgroundColor="Transparent" CornerRadius="22" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </mpowerkit:VirtualizeListViewCell>
                            </DataTemplate>
                        </mpowerkit:VirtualizeListView.ItemTemplate>
                    </mpowerkit:VirtualizeListView>

                    <!-- STICKY TOOLBAR (Changed HeightRequest to 48) -->
                    <Grid x:Name="StickyToolbar" VerticalOptions="Start" HeightRequest="48" IsVisible="False" ZIndex="5">
                        <ContentView ControlTemplate="{StaticResource SharedToolbarTemplate}" />
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" VerticalOptions="End" />
                    </Grid>
                </Grid>

                <ContentView Grid.Row="1" HeightRequest="70" BackgroundColor="{DynamicResource BgColor}" IsVisible="{Binding IsMediaSelected}" />
                <views:MobilePlayerPaneView Grid.Row="0" Grid.RowSpan="2" VerticalOptions="End" ZIndex="20"/>
            </Grid>
        </Grid>

        <ContentView x:Name="EdgeSwipeZone" WidthRequest="25" HorizontalOptions="Start" VerticalOptions="Fill" BackgroundColor="Transparent" ZIndex="49">
            <ContentView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnEdgePanUpdated" />
            </ContentView.GestureRecognizers>
        </ContentView>

        <BoxView x:Name="SidebarDarken" BackgroundColor="{DynamicResource SurfaceScrim}" Opacity="0" IsVisible="False" ZIndex="50">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSidebarOverlayTapped" />
                <PanGestureRecognizer PanUpdated="OnSidebarPanUpdated" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="SidebarGrid" HorizontalOptions="Fill" TranslationX="-5000" BackgroundColor="{DynamicResource BgColor}" ZIndex="51">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSidebarPanUpdated" />
            </Grid.GestureRecognizers>
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" Padding="12,12,16,16" ColumnDefinitions="Auto, *, Auto">
                    <ImageButton Grid.Column="0" Source="arrow_left_icon.png" Clicked="OnCloseSidebarClicked" Margin="0,0,12,0" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="8" BackgroundColor="Transparent" />
                    <Label Grid.Column="1" Text="Playlists" TextColor="{DynamicResource TitleColor}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                        <ImageButton Source="download_icon.png" Command="{Binding ImportPlaylistCommand}" Style="{StaticResource IconImageButton}" />
                        <ImageButton Source="plus_icon.png" Command="{Binding AddNewPlaylistCommand}" Style="{StaticResource IconImageButton}" />
                    </HorizontalStackLayout>
                </Grid>
                <mpowerkit:VirtualizeListView Grid.Row="1" ItemsSource="{Binding Playlists}" Scrolled="OnListScrolled">
                    <mpowerkit:VirtualizeListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <mpowerkit:VirtualizeListViewCell>
                                <Grid Padding="12,4">
                                    <Border StrokeShape="RoundRectangle 12" Padding="0" Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBgColor}" />
                                                <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Padding="12" BackgroundColor="Transparent">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPlaylistTapped" />
                                            </Grid.GestureRecognizers>
                                            <Image Grid.Column="0" Source="{Binding IconImageSource}" HeightRequest="60" WidthRequest="60" Aspect="AspectFill" VerticalOptions="Center">
                                                <Image.Clip>
                                                    <RoundRectangleGeometry CornerRadius="8" Rect="0,0,60,60" />
                                                </Image.Clip>
                                            </Image>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding ItemCount, StringFormat='{0} tracks'}" FontSize="12" TextColor="{DynamicResource MutedColor}" />
                                                    <Label Text="•" TextColor="{DynamicResource MutedColor}" FontSize="12" />
                                                    <Label Text="{Binding DisplayDuration}" FontSize="12" TextColor="{DynamicResource MutedColor}" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding CreatedAt, StringFormat='CREATED {0:MMM dd, yyyy}'}" FontSize="10" TextColor="{DynamicResource MutedColor}" TextTransform="Uppercase" />
                                            </VerticalStackLayout>
                                            <ImageButton Grid.Column="2" Source="ellipsis_vertical_icon.png" Clicked="OnPlaylistOptionsClicked" VerticalOptions="Center" HorizontalOptions="End" WidthRequest="40" HeightRequest="60" Padding="10,20" BackgroundColor="Transparent" CornerRadius="20" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </mpowerkit:VirtualizeListViewCell>
                        </DataTemplate>
                    </mpowerkit:VirtualizeListView.ItemTemplate>
                </mpowerkit:VirtualizeListView>
            </Grid>
            <ContentView WidthRequest="25" HorizontalOptions="End" VerticalOptions="Fill" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnSidebarPanUpdated" />
                </ContentView.GestureRecognizers>
            </ContentView>
        </Grid>

        <Grid IsVisible="{Binding IsModalVisible}" ZIndex="100">
            <BoxView BackgroundColor="{DynamicResource SurfaceScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ModalBackgroundTappedCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320" Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding ModalTitle}" TextColor="{DynamicResource TitleColor}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding ModalMessage}" TextColor="{DynamicResource TextColor}" IsVisible="{Binding IsModalMessageVisible}" />
                    <Entry Text="{Binding ModalInputText}" IsVisible="{Binding IsModalInputVisible}" Placeholder="Type here..." BackgroundColor="{DynamicResource SurfaceInput}" TextColor="{DynamicResource TextColor}" />
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,8,0,0">
                        <Button Text="Cancel" Command="{Binding ModalCancelCommand}" BackgroundColor="{DynamicResource CardColor}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="8" />
                        <Button Text="{Binding ModalConfirmText}" Command="{Binding ModalConfirmCommand}" BackgroundColor="{Binding ModalConfirmColor}" TextColor="{DynamicResource OnAccent}" CornerRadius="8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <views:SlideUpSheetHost x:Name="GlobalSheetHost" ZIndex="101" />

    </Grid>
</ContentPage>