<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Musicthingy.Models"
             xmlns:views="clr-namespace:Musicthingy.Views"
             xmlns:viewmodels="clr-namespace:Musicthingy.ViewModels"
             xmlns:mpowerkit="clr-namespace:MPowerKit.VirtualizeListView;assembly=MPowerKit.VirtualizeListView"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:helpers="clr-namespace:Musicthingy.Helpers"
             x:Class="Musicthingy.Views.MobileMainPage"
             x:Name="RootPage"
             BackgroundColor="{DynamicResource BgColor}"
             SafeAreaEdges="None">

    <!-- SafeAreaEdges="None" on the ContentPage AND the root Grid: the page
         window is drawn edge-to-edge and NOTHING on this page is auto-padded
         by MAUI. The inner content grid (nav row + list) instead opts back IN
         with SafeAreaEdges="Container", so the normal page furniture still
         clears the status/gesture strips - only the full-height player pane
         (a sibling in the ROOT grid) is deliberately edge-to-edge and owns
         its own strip clearance (continuous padding in its code-behind).
         Before this, the root Grid defaulted to Container: it arranged the
         pane inside the clipped strip-free box [TopInset .. screen - BottomInset]
         while still reporting the full window height - so FullScreen
         overhung both ends (header sliced at the top, pills sliced at the
         bottom) and the pane's own inset math was wrong at the extremes. -->

    <!-- Define the reusable Toolbar Template -->
    <ContentPage.Resources>
        <ControlTemplate x:Key="SharedToolbarTemplate">
            <Grid BackgroundColor="{DynamicResource BgColor}" SafeAreaEdges="None">
                <Grid Margin="16,0" ColumnDefinitions="Auto, *" SafeAreaEdges="None">

                    <!-- SORTING CONTROLS -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">

                        <!-- 1. Sort Direction Arrow -->
                        <ImageButton Source="{Binding SortDirectionIcon}" 
                                     Command="{Binding ToggleSortDirectionCommand}" 
                                     IsVisible="{Binding IsDirectionToggleVisible}"
                                     WidthRequest="48" HeightRequest="48" 
                                     Padding="12"
                                     CornerRadius="24"
                                     BackgroundColor="Transparent"
                                     VerticalOptions="Center">
                            <ImageButton.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{Binding BindingContext.TextColor, Source={x:Reference RootPage}}" />
                            </ImageButton.Behaviors>
                        </ImageButton>

                        <!-- 2. Sort Field Picker Button -->
                        <Border BackgroundColor="Transparent" Stroke="Transparent" Padding="0,8" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSortOptionsClicked" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Image Source="list_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" IsVisible="{Binding IsSortCustom}">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{DynamicResource TextColor}" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Text="{Binding CurrentSortModeText}" TextColor="{DynamicResource TextColor}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" HorizontalOptions="End">

                        <!-- FILTER CONTROLS -->
                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center">

                            <!-- The Text: ALWAYS opens the sheet, so you can still edit active filters -->
                            <ContentView Padding="0,8" VerticalOptions="Center">
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenFilterSheetCommand}" />
                                </ContentView.GestureRecognizers>
                                <Label Text="Filter" TextColor="{Binding FilterIconColor}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                            </ContentView>

                            <!-- The Icon: Clears filter when active, opens sheet when inactive -->
                            <ImageButton Source="{Binding FilterToolbarIcon}" 
                                         Command="{Binding ToolbarFilterIconActionCommand}"
                                         WidthRequest="48" HeightRequest="48"
                                         Padding="12"
                                         CornerRadius="24"
                                         BackgroundColor="Transparent"
                                         VerticalOptions="Center">
                                <ImageButton.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{Binding BindingContext.FilterIconColor, Source={x:Reference RootPage}}" />
                                </ImageButton.Behaviors>
                            </ImageButton>

                        </HorizontalStackLayout>

                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentPage.Resources>

    <!-- ROOT grid: SafeAreaEdges="None" so the full-height player pane (a
         sibling, ZIndex 20) is arranged over the WHOLE window - the strips
         included - instead of inside MAUI's padded safe box. Every other
         child that must clear the strips opts back in with
         SafeAreaEdges="Container" individually. -->
    <Grid SafeAreaEdges="None">
        <!-- Inner content grid: opts back into MAUI's automatic Container
             padding, so the nav row clears the status strip and the
             list/spacer clear the gesture strip exactly as before. -->
        <Grid RowDefinitions="Auto, *" SafeAreaEdges="Container">
            <!-- Custom Navigation Bar. The Container padding above keeps it
                 clear of the status strip automatically - no manual insets. -->
            <Grid Grid.Row="0" HeightRequest="56" BackgroundColor="{DynamicResource BgColor}" ZIndex="10"
                  Padding="8,0" ColumnDefinitions="44, *, 44" ColumnSpacing="4" SafeAreaEdges="None">

                <ContentView Grid.Column="0" VerticalOptions="Fill" HorizontalOptions="Fill">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHamburgerTapped" />
                    </ContentView.GestureRecognizers>
                    <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Fill="{DynamicResource TitleColor}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="24" HeightRequest="24" />
                </ContentView>

                <views:SearchBarView x:Name="MainSearchBar" Grid.Column="1" VerticalOptions="Center" />

                <!-- SETTINGS BUTTON ON THE RIGHT -->
                <ImageButton Grid.Column="2" Source="settings_icon.png" Command="{Binding OpenSettingsCommand}" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="Transparent" Padding="8">
                    <ImageButton.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                    </ImageButton.Behaviors>
                </ImageButton>
            </Grid>

            <!-- Detail Grid (Tracks + Bottom Player): the parent content grid's
                 Container padding keeps it clear of the gesture-bar strip. -->
            <Grid Grid.Row="1" RowDefinitions="*, Auto" SafeAreaEdges="None">
                <Grid Grid.Row="0">
                    <mpowerkit:VirtualizeListView x:Name="TracksListView" 
                                                  ItemsSource="{Binding DisplayedItems}" 
                                                  Scrolled="OnListScrolled"
                                                  Header="{Binding .}">

                        <mpowerkit:VirtualizeListView.HeaderTemplate>
                            <DataTemplate x:DataType="viewmodels:MainViewModel">
                                <VerticalStackLayout HorizontalOptions="Fill">

                                    <VerticalStackLayout SizeChanged="OnPlaylistInfoSizeChanged" Padding="16,16,16,16" Spacing="12">

                                        <Image Source="{Binding SelectedPlaylist.IconImageSource}" WidthRequest="220" HeightRequest="220" Aspect="AspectFill" HorizontalOptions="Center">
                                            <Image.Clip>
                                                <RoundRectangleGeometry CornerRadius="16" Rect="0,0,220,220" />
                                            </Image.Clip>
                                        </Image>

                                        <Label Text="{Binding SelectedPlaylist.Name}" TextColor="{DynamicResource TitleColor}" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="0,6,0,0"/>

                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                            <Label Text="{Binding SelectedPlaylist.CreatedAt, StringFormat='{0:yyyy}'}" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                            <Label Text="•" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                            <Label Text="{Binding SelectedPlaylist.ItemCount, StringFormat='{0} tracks'}" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                            <Label Text="•" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                            <Label Text="{Binding SelectedPlaylist.DisplayDuration}" TextColor="{DynamicResource MutedColor}" FontSize="14" />
                                        </HorizontalStackLayout>

                                        <Grid ColumnDefinitions="3*, 2*, 48" ColumnSpacing="8" Margin="8,8,8,0">

                                            <!-- PLAY & SHUFFLE UNITED -->
                                            <Border Grid.Column="0" Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="0" HeightRequest="48">
                                                <Grid ColumnDefinitions="*, 1, *">
                                                    <ImageButton Grid.Column="0" Source="play_icon.png" Command="{Binding PlayPlaylistCommand}" HeightRequest="48" HorizontalOptions="Fill" CornerRadius="0" BackgroundColor="Transparent" Padding="12" />
                                                    <BoxView Grid.Column="1" BackgroundColor="{DynamicResource BorderColor}" WidthRequest="1" Margin="0,12" VerticalOptions="Fill" />
                                                    <ImageButton Grid.Column="2" Source="shuffle_icon.png" Command="{Binding ShufflePlaylistCommand}" HeightRequest="48" HorizontalOptions="Fill" CornerRadius="0" BackgroundColor="Transparent" Padding="12" />
                                                </Grid>
                                            </Border>

                                            <!-- ADD ITEM BUTTON -->
                                            <BoxView x:Name="AddIconColorHelper" Color="{DynamicResource PrimaryButtonText}" IsVisible="False" />

                                            <ImageButton Grid.Column="1" Source="plus_icon.png" Command="{Binding AddNewTrackCommand}" HeightRequest="48" HorizontalOptions="Fill" CornerRadius="24" BackgroundColor="{DynamicResource PrimaryButtonColor}" BorderColor="{DynamicResource PrimaryButtonBorder}" BorderWidth="1" Padding="12">
                                                <ImageButton.Behaviors>
                                                    <toolkit:IconTintColorBehavior TintColor="{Binding Color, Source={x:Reference AddIconColorHelper}}" />
                                                </ImageButton.Behaviors>
                                            </ImageButton>

                                            <!-- ELLIPSIS -->
                                            <ImageButton Grid.Column="2" Source="ellipsis_vertical_icon.png" BindingContext="{Binding SelectedPlaylist}" Clicked="OnPlaylistOptionsClicked" WidthRequest="48" HeightRequest="48" CornerRadius="24" BackgroundColor="{DynamicResource CardColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" Padding="12" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <!-- NATIVE INLINE TOOLBAR -->
                                    <Grid HeightRequest="48">
                                        <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" VerticalOptions="Start" ZIndex="1" />
                                        <ContentView ControlTemplate="{StaticResource SharedToolbarTemplate}" />
                                    </Grid>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </mpowerkit:VirtualizeListView.HeaderTemplate>

                        <mpowerkit:VirtualizeListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistItem">
                                <mpowerkit:VirtualizeListViewCell>
                                    <Grid>
                                        <!-- Selection Container -->
                                        <Border Margin="8,0,8,0" StrokeThickness="0" Background="Transparent">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <!-- Main Content Row: Ripple effect and Tap applied here -->
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Padding="8" helpers:AndroidRipple.AddRipple="True">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTrackTapped" />
                                                </Grid.GestureRecognizers>

                                                <!-- Icon area — tap to toggle selection -->
                                                <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnTrackIconTapped" />
                                                    </Grid.GestureRecognizers>
                                                    <Image Source="{Binding ItemIconSource}" Aspect="AspectFill">
                                                        <Image.Clip>
                                                            <RoundRectangleGeometry CornerRadius="7" Rect="0,0,44,44" />
                                                        </Image.Clip>
                                                    </Image>
                                                    <Border WidthRequest="44" HeightRequest="44" BackgroundColor="#A0000000" IsVisible="{Binding IsMultiSelected}" StrokeThickness="0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="7" />
                                                        </Border.StrokeShape>
                                                        <Image Source="check_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" HorizontalOptions="Center">
                                                            <Image.Behaviors>
                                                                <toolkit:IconTintColorBehavior TintColor="#FFFFFF" />
                                                            </Image.Behaviors>
                                                        </Image>
                                                    </Border>
                                                </Grid>

                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                    <Grid HeightRequest="24" IsClippedToBounds="True">
                                                        <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                                            <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag1}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding Tag1}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag2}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding Tag2}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag3}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding Tag3}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag4}">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding Tag4}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </VerticalStackLayout>

                                                <ImageButton Grid.Column="2" 
                                                             Source="ellipsis_vertical_icon.png" 
                                                             Clicked="OnTrackOptionsClicked" 
                                                             VerticalOptions="Center" 
                                                             HorizontalOptions="End" 
                                                             WidthRequest="44" 
                                                             HeightRequest="44" 
                                                             Padding="12" 
                                                             BackgroundColor="Transparent" 
                                                             BorderColor="Transparent"
                                                             BorderWidth="0"
                                                             CornerRadius="22" />
                                            </Grid>
                                        </Border>

                                    </Grid>
                                </mpowerkit:VirtualizeListViewCell>
                            </DataTemplate>
                        </mpowerkit:VirtualizeListView.ItemTemplate>
                    </mpowerkit:VirtualizeListView>

                    <!-- STICKY TOOLBAR -->
                    <Grid x:Name="StickyToolbar" VerticalOptions="Start" HeightRequest="48" IsVisible="False" ZIndex="5">
                        <ContentView ControlTemplate="{StaticResource SharedToolbarTemplate}" />
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" VerticalOptions="End" />
                    </Grid>

                    <!-- TRACK SELECTION TOOLBAR (visible only when tracks are selected) -->
                    <Grid VerticalOptions="Start" HeightRequest="56"
                          IsVisible="{Binding IsSelectionToolbarVisible}" ZIndex="6"
                          BackgroundColor="{DynamicResource BgColor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" VerticalOptions="End" Grid.ColumnSpan="5" />
                        <ImageButton Grid.Column="0" Source="x_icon.png" Clicked="OnCancelSelectionClicked" WidthRequest="48" HeightRequest="48" Padding="10" BackgroundColor="Transparent" BorderColor="Transparent" BorderWidth="0" CornerRadius="24" VerticalOptions="Center" Margin="4,0,0,0">
                            <ImageButton.Behaviors><toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" /></ImageButton.Behaviors>
                        </ImageButton>
                        <Label Grid.Column="1" Text="{Binding SelectionCountText}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TitleColor}" VerticalOptions="Center" Margin="8,0,0,0" />
                        <ImageButton Grid.Column="2" Source="check_icon.png" Clicked="OnSelectAllClicked" WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent" BorderColor="Transparent" BorderWidth="0" CornerRadius="24" VerticalOptions="Center">
                            <ImageButton.Behaviors><toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" /></ImageButton.Behaviors>
                        </ImageButton>
                        <ImageButton Grid.Column="3" Source="play_icon.png" Clicked="OnPlaySelectedClicked" WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent" BorderColor="Transparent" BorderWidth="0" CornerRadius="24" VerticalOptions="Center">
                            <ImageButton.Behaviors><toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" /></ImageButton.Behaviors>
                        </ImageButton>
                        <ImageButton Grid.Column="4" Source="shuffle_icon.png" Clicked="OnShuffleSelectedClicked" WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent" BorderColor="Transparent" BorderWidth="0" CornerRadius="24" VerticalOptions="Center" Margin="0,0,4,0">
                            <ImageButton.Behaviors><toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" /></ImageButton.Behaviors>
                        </ImageButton>
                    </Grid>
                </Grid>

                <!-- Bottom spacer: matches the mini pane's total height
                     (72dp header + gesture inset) so the list's last row
                     scrolls fully clear of the mini player. Code-behind
                     keeps the request in sync when insets change. -->
                <ContentView x:Name="MiniPlayerSpacer" Grid.Row="1" HeightRequest="72" BackgroundColor="{DynamicResource BgColor}" IsVisible="{Binding IsMediaSelected}" />
            </Grid>
        </Grid>

        <!-- Full-height player pane: lives in the ROOT grid (which is
             SafeAreaEdges="None", see above) so its parent box is the WHOLE
             window - FullScreen paints under both transparent system bars.
             ZIndex 20 keeps it below the sidebar (50/51), search results
             (60/61), modals (100) and the global sheet host (101); the list
             keeps clearing the mini-player via the spacer row above. The
             pane itself opts out of Container padding (SafeAreaEdges="None"
             on its ContentView root) and owns its strip clearance through
             continuous PaneContent padding in its code-behind. -->
        <views:MobilePlayerPaneView VerticalOptions="End" ZIndex="20"/>

        <!-- Touch / Sidebar Overlays -->
        <!-- Starts below the 56dp header so the hamburger button is tappable.
             The content grid's Container padding keeps the header below the
             status strip; this zone lives in the ROOT grid (None), so its
             56dp margin matches the header's offset inside that grid (the
             inset that Container adds inside the content grid equals the
             strip this margin clears). -->
        <ContentView x:Name="EdgeSwipeZone" WidthRequest="25" HorizontalOptions="Start" VerticalOptions="Fill" Margin="0,56,0,0" BackgroundColor="Transparent" ZIndex="49">
            <ContentView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnEdgePanUpdated" />
            </ContentView.GestureRecognizers>
        </ContentView>

        <!-- NO SafeAreaEdges here: the property does not exist on BoxView in
             .NET 10 MAUI (only ContentPage / Layout / ScrollView / ContentView
             / Border) and throws XamlParseException at parse time - the
             "crashes unless a debugger is attached" round-6 bug. The scrim is
             a full-window cover and inherits the root grid's None behavior. -->
        <BoxView x:Name="SidebarDarken" BackgroundColor="{DynamicResource SurfaceScrim}" Opacity="0" IsVisible="False" ZIndex="50">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSidebarOverlayTapped" />
                <PanGestureRecognizer PanUpdated="OnSidebarPanUpdated" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="SidebarGrid" HorizontalOptions="Fill" TranslationX="-5000" BackgroundColor="{DynamicResource BgColor}" ZIndex="51" SafeAreaEdges="Container">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnSidebarPanUpdated" />
            </Grid.GestureRecognizers>
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" Padding="8,8,8,10" ColumnDefinitions="40, *, Auto" ColumnSpacing="4">
                    <ImageButton Grid.Column="0" Source="arrow_left_icon.png" Clicked="OnCloseSidebarClicked" VerticalOptions="Center" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="8" BackgroundColor="Transparent" />
                    <views:SearchBarView x:Name="SidebarSearchBar" Grid.Column="1" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" Margin="4,0,0,0">
                        <ImageButton Source="download_icon.png" Command="{Binding ImportPlaylistCommand}" Style="{StaticResource IconImageButton}" />
                        <ImageButton Source="plus_icon.png" Command="{Binding AddNewPlaylistCommand}" Style="{StaticResource IconImageButton}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Playlist Selection Toolbar (inside sidebar) -->
                <Grid Grid.Row="1" HeightRequest="52" IsVisible="{Binding IsPlaylistSelectionMode}"
                      BackgroundColor="{DynamicResource BgColor}" ZIndex="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ImageButton Grid.Column="0" Source="x_icon.png" Clicked="OnCancelSelectionClicked"
                                 WidthRequest="48" HeightRequest="48" Padding="10" BackgroundColor="Transparent"
                                 BorderColor="Transparent" BorderWidth="0" CornerRadius="24" VerticalOptions="Center"
                                 Margin="4,0,0,0">
                        <ImageButton.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                        </ImageButton.Behaviors>
                    </ImageButton>

                    <Label Grid.Column="1" Text="{Binding SelectedPlaylistCount, StringFormat='{0} selected'}"
                           FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TitleColor}"
                           VerticalOptions="Center" Margin="8,0,0,0" />

                    <ImageButton Grid.Column="2" Source="check_icon.png" Clicked="OnSelectAllPlaylistsClicked"
                                 WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent"
                                 BorderColor="Transparent" BorderWidth="0" CornerRadius="24" VerticalOptions="Center">
                        <ImageButton.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                        </ImageButton.Behaviors>
                    </ImageButton>

                    <ImageButton Grid.Column="3" Source="play_icon.png" Clicked="OnPlaySelectedClicked"
                                 WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent"
                                 BorderColor="Transparent" BorderWidth="0" CornerRadius="24" VerticalOptions="Center">
                        <ImageButton.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                        </ImageButton.Behaviors>
                    </ImageButton>

                    <ImageButton Grid.Column="4" Source="shuffle_icon.png" Clicked="OnShuffleSelectedClicked"
                                 WidthRequest="48" HeightRequest="48" Padding="12" BackgroundColor="Transparent"
                                 BorderColor="Transparent" BorderWidth="0" CornerRadius="24" VerticalOptions="Center"
                                 Margin="0,0,4,0">
                        <ImageButton.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                        </ImageButton.Behaviors>
                    </ImageButton>
                    
                    <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" VerticalOptions="End" Grid.ColumnSpan="5" />
                </Grid>

                <mpowerkit:VirtualizeListView Grid.Row="2" ItemsSource="{Binding Playlists}" Scrolled="OnListScrolled">
                    <mpowerkit:VirtualizeListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <mpowerkit:VirtualizeListViewCell>
                                <Grid Padding="12,4">
                                    <Border StrokeShape="RoundRectangle 12" Padding="0" Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <!-- Main Content Row -->
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Padding="12" helpers:AndroidRipple.AddRipple="True">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPlaylistTapped" />
                                            </Grid.GestureRecognizers>

                                            <!-- Playlist icon — tap to toggle selection -->
                                            <Grid Grid.Column="0" VerticalOptions="Center">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPlaylistIconTapped" />
                                                </Grid.GestureRecognizers>
                                                <Image Source="{Binding IconImageSource}" HeightRequest="60" WidthRequest="60" Aspect="AspectFill">
                                                    <Image.Clip>
                                                        <RoundRectangleGeometry CornerRadius="8" Rect="0,0,60,60" />
                                                    </Image.Clip>
                                                </Image>
                                                <Border HeightRequest="60" WidthRequest="60" BackgroundColor="#A0000000" IsVisible="{Binding IsMultiSelected}" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Image Source="check_icon.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" HorizontalOptions="Center">
                                                        <Image.Behaviors>
                                                            <toolkit:IconTintColorBehavior TintColor="#FFFFFF" />
                                                        </Image.Behaviors>
                                                    </Image>
                                                </Border>
                                            </Grid>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding ItemCount, StringFormat='{0} tracks'}" FontSize="12" TextColor="{DynamicResource MutedColor}" />
                                                    <Label Text="•" TextColor="{DynamicResource MutedColor}" FontSize="12" />
                                                    <Label Text="{Binding DisplayDuration}" FontSize="12" TextColor="{DynamicResource MutedColor}" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding CreatedAt, StringFormat='CREATED {0:MMM dd, yyyy}'}" FontSize="10" TextColor="{DynamicResource MutedColor}" TextTransform="Uppercase" />
                                            </VerticalStackLayout>

                                            <ImageButton Grid.Column="2" 
                                                         Source="ellipsis_vertical_icon.png" 
                                                         Clicked="OnPlaylistOptionsClicked" 
                                                         VerticalOptions="Center" 
                                                         HorizontalOptions="End" 
                                                         WidthRequest="40" 
                                                         HeightRequest="60" 
                                                         Padding="10,20" 
                                                         BackgroundColor="Transparent" 
                                                         BorderColor="Transparent"
                                                         BorderWidth="0"
                                                         CornerRadius="20" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </mpowerkit:VirtualizeListViewCell>
                        </DataTemplate>
                    </mpowerkit:VirtualizeListView.ItemTemplate>
                </mpowerkit:VirtualizeListView>
            </Grid>
            <ContentView WidthRequest="25" HorizontalOptions="End" VerticalOptions="Fill" BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnSidebarPanUpdated" />
                </ContentView.GestureRecognizers>
            </ContentView>
        </Grid>

        <!-- Search results (above the sidebar, below the modal/sheet layers).
             The top margin keeps the search bars and their buttons usable;
             Container keeps them clear of the status strip. -->
        <views:SearchResultsView x:Name="MainSearchResults" ZIndex="60" Margin="0,56,0,0" SafeAreaEdges="Container" />
        <views:SearchResultsView x:Name="SidebarSearchResults" ZIndex="61" Margin="0,56,0,0" SafeAreaEdges="Container" />

        <!-- Modal Dialog -->
        <Grid IsVisible="{Binding IsModalVisible}" ZIndex="100" SafeAreaEdges="Container">
            <BoxView BackgroundColor="{DynamicResource ModalSurfaceScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ModalBackgroundTappedCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320" Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding ModalTitle}" TextColor="{DynamicResource TitleColor}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding ModalMessage}" TextColor="{DynamicResource TextColor}" IsVisible="{Binding IsModalMessageVisible}" />
                    <Entry Text="{Binding ModalInputText}" IsVisible="{Binding IsModalInputVisible}" Placeholder="Type here..." BackgroundColor="{DynamicResource SurfaceInput}" TextColor="{DynamicResource TextColor}" />
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,8,0,0">
                        <Button Text="Cancel" Command="{Binding ModalCancelCommand}" BackgroundColor="{DynamicResource SecondaryButtonColor}" TextColor="{DynamicResource SecondaryButtonText}" BorderColor="{DynamicResource SecondaryButtonBorder}" BorderWidth="1" CornerRadius="8" />
                        <Button Text="{Binding ModalConfirmText}" Command="{Binding ModalConfirmCommand}" BackgroundColor="{Binding ModalConfirmColor}" TextColor="{Binding ModalConfirmTextColor}" CornerRadius="8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <views:SlideUpSheetHost x:Name="GlobalSheetHost" ZIndex="101" SafeAreaEdges="Container" />

    </Grid>
</ContentPage>