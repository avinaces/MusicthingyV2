<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musicthingy.Views.EditPlaylistGeneralTab">

    <ScrollView VerticalScrollBarVisibility="Never">

        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*" RowSpacing="16" Padding="0,0,0,16">

            <!-- 0: Icon picker -->
            <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="8" Margin="0,0,0,10">
                <Border WidthRequest="110" HeightRequest="110" StrokeShape="RoundRectangle 16" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" BackgroundColor="{DynamicResource SurfaceInput}">
                    <Image Source="{Binding ItemIconSource}" Aspect="AspectFill" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickIconCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Label Text="Tap to change" FontSize="12" TextColor="{DynamicResource MutedColor}" HorizontalOptions="Center"/>
                <Button Text="Reset" Command="{Binding ResetIconCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Danger}" HeightRequest="32" Padding="8,0" />
            </VerticalStackLayout>

            <!-- 1: Name -->
            <VerticalStackLayout Grid.Row="1" Spacing="4">
                <!-- Keep the static label on Windows only -->
                <Label Text="Playlist Name" FontSize="14" TextColor="{DynamicResource TextColor}" Margin="4,0,0,0">
                    <Label.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                            <On Platform="WinUI" Value="True" />
                        </OnPlatform>
                    </Label.IsVisible>
                </Label>

                <Entry Text="{Binding EditName}" 
                       Placeholder="Playlist Name" 
                       TextColor="{DynamicResource TextColor}" />
            </VerticalStackLayout>

            <!-- 2: Source (optional) - refactored to match in case it's uncommented later -->
            <!--
            <VerticalStackLayout Grid.Row="2" Spacing="4">
                <Label Text="Source URL (Optional)" FontSize="14" TextColor="{DynamicResource TextColor}" Margin="4,0,0,0">
                    <Label.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                            <On Platform="WinUI" Value="True" />
                        </OnPlatform>
                    </Label.IsVisible>
                </Label>
                
                <Entry Text="{Binding EditSource}" 
                       Placeholder="Source URL (Optional)" 
                       TextColor="{DynamicResource TextColor}" />
            </VerticalStackLayout>
            -->

        </Grid>
    </ScrollView>
</ContentView>