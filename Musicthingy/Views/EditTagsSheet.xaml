<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Musicthingy.Views"
             x:Class="Musicthingy.Views.EditTagsSheet"
             x:Name="TagsSheetRoot"
             BackgroundColor="Transparent">

    <local:BottomSheetContainer Title="Edit Tags" CloseRequested="OnCloseRequested">

        <local:BottomSheetContainer.Body>
            <Grid RowDefinitions="Auto, *">

                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="12" Margin="0,0,0,16">
                    <Border BackgroundColor="#161b22" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                        <Entry Text="{Binding SearchText}" Placeholder="Search or create tag..." TextColor="White" PlaceholderColor="#8b949e" BackgroundColor="Transparent" HeightRequest="48" />
                    </Border>
                    <Button Grid.Column="1" Text="Create" Command="{Binding CreateTagCommand}" IsVisible="{Binding CanCreateTag}" BackgroundColor="#2d5b8c" TextColor="White" CornerRadius="8" HeightRequest="48" />
                </Grid>

                <!-- Expands until it needs to scroll automatically -->
                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start" AlignContent="Start" BindableLayout.ItemsSource="{Binding DisplayTags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:SelectableTag">
                                <Border BackgroundColor="{Binding BackgroundColor}" Stroke="{Binding BorderColor}" StrokeThickness="1" HeightRequest="36" Padding="14,0" Margin="2,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="9"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Form.ToggleTagCommand, Source={x:Reference TagsSheetRoot}, x:DataType='local:EditTagsSheet'}" 
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Name}" TextColor="{Binding TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" VerticalTextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>
            </Grid>
        </local:BottomSheetContainer.Body>

        <local:BottomSheetContainer.Footer>
            <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="#21262d" TextColor="White" BorderColor="#30363d" BorderWidth="1" CornerRadius="8" HeightRequest="44" Padding="16,0" />
                <Button Text="Save" Clicked="OnSaveClicked" BackgroundColor="#2d5b8c" TextColor="White" CornerRadius="8" HeightRequest="44" Padding="24,0" />
            </HorizontalStackLayout>
        </local:BottomSheetContainer.Footer>

    </local:BottomSheetContainer>
</ContentView>