<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musicthingy.Views.BottomSheetContainer"
             x:Name="Root">

    <!-- VerticalOptions="End" forces the sheet to hug the bottom.
         RowDefinitions="Auto, *, Auto" allows the middle row to expand 
         up to MaximumHeightRequest, at which point it will scroll. -->
    <Border BackgroundColor="#161b22" Stroke="#30363d" StrokeThickness="1" 
            Margin="-1,0,-1,-2" Padding="0" VerticalOptions="End" MaximumHeightRequest="750">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16,16,0,0" />
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto, *, Auto" Padding="20, 16, 20, 32">

            <!-- Draggable Header -->
            <Grid Grid.Row="0" BackgroundColor="Transparent" Padding="0,0,0,16" x:Name="DragZone">
                <Grid.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </Grid.GestureRecognizers>

                <VerticalStackLayout Spacing="16">
                    <RoundRectangle WidthRequest="36" HeightRequest="5" CornerRadius="2.5" Fill="#484f58" HorizontalOptions="Center" />
                    <Label Text="{Binding Title, Source={x:Reference Root}}" TextColor="#adcff0" FontSize="20" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>

            <!-- Body (Dynamic Size) -->
            <ContentView Grid.Row="1" Content="{Binding Body, Source={x:Reference Root}}" />

            <!-- Custom Footer -->
            <ContentView Grid.Row="2" Content="{Binding Footer, Source={x:Reference Root}}" Margin="0,16,0,0" IsVisible="{Binding HasFooter, Source={x:Reference Root}}" />

        </Grid>
    </Border>
</ContentView>