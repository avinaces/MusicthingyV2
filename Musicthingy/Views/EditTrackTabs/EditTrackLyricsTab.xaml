<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musicthingy.Views.EditTrackLyricsTab"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" BackgroundColor="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,0,0,16">
            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="Search Online (Auto)" Command="{Binding SearchOnlineCommand}" BackgroundColor="{DynamicResource PrimaryButtonColor}" TextColor="{DynamicResource PrimaryButtonText}" CornerRadius="8" HeightRequest="48"/>

                    <!-- The helper handles the Icon Tint Color logic -->
                    <BoxView x:Name="SettingsColorHelper" Color="{DynamicResource SecondaryButtonText}" IsVisible="False">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView" Binding="{Binding IsAdvancedOpen}" Value="True">
                                <Setter Property="Color" Value="{DynamicResource PrimaryButtonText}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>

                    <!-- The button handles the Background Color logic -->
                    <ImageButton Grid.Column="1" 
                        Source="settings_icon.png" 
                        Command="{Binding ToggleAdvancedCommand}" 
                        WidthRequest="48" 
                        HeightRequest="48" 
                        BackgroundColor="{DynamicResource BorderColor}" 
                        CornerRadius="8" 
                        Padding="12">

                        <ImageButton.Behaviors>
                            <!-- Binds to the BoxView, changing automatically when the BoxView's trigger fires -->
                            <toolkit:IconTintColorBehavior TintColor="{Binding Color, Source={x:Reference SettingsColorHelper}}" />
                        </ImageButton.Behaviors>

                        <ImageButton.Triggers>
                            <DataTrigger TargetType="ImageButton" Binding="{Binding IsAdvancedOpen}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryButtonColor}"/>
                            </DataTrigger>
                        </ImageButton.Triggers>

                    </ImageButton>
                </Grid>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdvancedOpen}">
                    <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" Margin="0,4"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Title" TextColor="{DynamicResource TextColor}" FontSize="14"/>
                            <Border BackgroundColor="{DynamicResource SurfaceInput}" Stroke="{DynamicResource InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                                <Entry Text="{Binding SearchTitle}" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" HeightRequest="48"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Artist" TextColor="{DynamicResource TextColor}" FontSize="14"/>
                            <Border BackgroundColor="{DynamicResource SurfaceInput}" Stroke="{DynamicResource InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                                <Entry Text="{Binding SearchArtist}" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" HeightRequest="48"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Preferred Format" TextColor="{DynamicResource TextColor}" FontSize="14"/>
                        <Border Stroke="{DynamicResource InputBorderColor}" StrokeThickness="1" BackgroundColor="{DynamicResource SurfaceInput}" StrokeShape="RoundRectangle 8" Padding="12,0">
                            <Picker SelectedItem="{Binding SearchType}" TextColor="{DynamicResource TextColor}" Title="Select Format...">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Timed Lyrics (LRC)</x:String>
                                        <x:String>Plain Text (Untimed)</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsSearching}" Color="{DynamicResource AccentColor}" HeightRequest="24" IsVisible="{Binding IsSearching}" Margin="0,4,0,0"/>

            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" BackgroundColor="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0">
            <Editor x:Name="LyricsEditor" Text="{Binding LyricsText}" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" VerticalOptions="Fill" HorizontalOptions="Fill" Margin="12" FontSize="14" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"/>
        </Border>
    </Grid>
</ContentView>
