<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musicthingy.Views.EditTrackGeneralTab"
             xmlns:views="clr-namespace:Musicthingy.Views">

    <ScrollView VerticalScrollBarVisibility="Never">

        <!-- Simplified the main Grid to a single column, using nested layouts for side-by-side elements -->
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="*" RowSpacing="16" Padding="0,0,0,16">

            <!-- 0: Icon picker -->
            <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="8" Margin="0,0,0,10">
                <Border WidthRequest="96" HeightRequest="96" StrokeShape="RoundRectangle 16" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" BackgroundColor="{DynamicResource SurfaceInput}">
                    <Image Source="{Binding ItemIconSource}" Aspect="AspectFill" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickIconCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Label Text="Tap to change" FontSize="12" TextColor="{DynamicResource MutedColor}" HorizontalOptions="Center"/>
                <Button Text="Reset" Command="{Binding ResetIconCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Danger}" HeightRequest="32" Padding="8,0" />
            </VerticalStackLayout>

            <!-- 1: Title Input & Validation -->
            <VerticalStackLayout Grid.Row="1" Spacing="4">
                <!-- Keep the static label on Windows only, since WinUI doesn't support M3 floating placeholders -->
                <Label Text="Title *" FontSize="14" TextColor="{DynamicResource TextColor}" Margin="4,0,0,0">
                    <Label.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                            <On Platform="WinUI" Value="True" />
                        </OnPlatform>
                    </Label.IsVisible>
                </Label>

                <Entry Text="{Binding EditTitle}" 
                       Placeholder="Title *" 
                       TextColor="{DynamicResource TextColor}" />

                <views:AutoMarqueeLabel Text="{Binding TitleError}" 
                                        TextColor="{DynamicResource Danger}" 
                                        FontSize="12" 
                                        IsVisible="{Binding HasTitleError}" 
                                        Margin="4,0,0,0" />
            </VerticalStackLayout>

            <!-- 2: URL Input & Validation -->
            <VerticalStackLayout Grid.Row="2" Spacing="4">
                <Label Text="Stream URL / Path *" FontSize="14" TextColor="{DynamicResource TextColor}" Margin="4,0,0,0">
                    <Label.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                            <On Platform="WinUI" Value="True" />
                        </OnPlatform>
                    </Label.IsVisible>
                </Label>

                <Entry Text="{Binding EditUrl}" 
                       Placeholder="Stream URL / Path *" 
                       TextColor="{DynamicResource TextColor}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,0,0,0">
                    <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsCheckingUrl}" IsVisible="{Binding IsCheckingUrl}" Color="{DynamicResource Accent}" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                    <views:AutoMarqueeLabel Grid.Column="1" Text="{Binding UrlError}" TextColor="{DynamicResource Danger}" FontSize="12" VerticalOptions="Center" HorizontalOptions="Fill" IsVisible="{Binding HasUrlError}" />
                </Grid>
            </VerticalStackLayout>

            <!-- 3: Times Grid -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- Start Time -->
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Start Time (sec)" FontSize="14" TextColor="{DynamicResource TextColor}" Margin="4,0,0,0">
                        <Label.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                                <On Platform="WinUI" Value="True" />
                            </OnPlatform>
                        </Label.IsVisible>
                    </Label>
                    <Entry Text="{Binding EditStartTime}" 
                           Placeholder="Start Time (sec)" 
                           Keyboard="Numeric" 
                           TextColor="{DynamicResource TextColor}" />
                </VerticalStackLayout>

                <!-- End Time -->
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="End Time (sec)" FontSize="14" TextColor="{DynamicResource TextColor}" Margin="4,0,0,0">
                        <Label.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                                <On Platform="WinUI" Value="True" />
                            </OnPlatform>
                        </Label.IsVisible>
                    </Label>
                    <Entry Text="{Binding EditEndTime}" 
                           Placeholder="End Time (sec)" 
                           Keyboard="Numeric" 
                           TextColor="{DynamicResource TextColor}" />
                </VerticalStackLayout>
            </Grid>

            <!-- 4: Last Played -->
            <Label Grid.Row="4" Text="{Binding LastPlayedText, StringFormat='Last Played: {0}'}" TextColor="{DynamicResource MutedColor}" FontSize="12" HorizontalOptions="Center" Margin="0,8,0,0">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding LastPlayedText}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            
            <!-- 5: Views -->
            <Label Grid.Row="5" Text="{Binding Views, StringFormat='Views: {0}'}" TextColor="{DynamicResource MutedColor}" FontSize="12" HorizontalOptions="Center" Margin="0,4,0,0">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Views}" Value="0">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

        </Grid>
    </ScrollView>
</ContentView>