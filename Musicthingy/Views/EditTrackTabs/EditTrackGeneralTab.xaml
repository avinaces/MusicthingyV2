<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musicthingy.Views.EditTrackGeneralTab">

    <ScrollView VerticalScrollBarVisibility="Never">

        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="*,*" RowSpacing="6" Padding="0,0,0,16">

            <!-- 0: Icon picker -->
            <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="Center" Spacing="8" Margin="0,0,0,10">
                <Border WidthRequest="96" HeightRequest="96" StrokeShape="RoundRectangle 16" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" BackgroundColor="{DynamicResource SurfaceInput}">
                    <Image Source="{Binding ItemIconSource}" Aspect="AspectFill" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickIconCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Label Text="Tap to change" FontSize="12" TextColor="{DynamicResource MutedColor}" HorizontalOptions="Center"/>
                <Button Text="Reset" Command="{Binding ResetIconCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Danger}" HeightRequest="32" Padding="8,0" />
            </VerticalStackLayout>

            <!-- 1 & 2: Title -->
            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="Title" TextColor="{DynamicResource TextColor}" FontSize="14" Margin="0,6,0,0"/>
            <Border Grid.Row="2" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource SurfaceInput}" Stroke="{DynamicResource InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                <Entry Text="{Binding EditTitle}" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" HeightRequest="48"/>
            </Border>

            <!-- 3 & 4: URL -->
            <Label Grid.Row="3" Grid.ColumnSpan="2" Text="Stream URL / Path" TextColor="{DynamicResource TextColor}" FontSize="14" Margin="0,6,0,0"/>
            <Border Grid.Row="4" Grid.ColumnSpan="2" BackgroundColor="{DynamicResource SurfaceInput}" Stroke="{DynamicResource InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                <Entry Text="{Binding EditUrl}" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" HeightRequest="48"/>
            </Border>

            <!-- 5 & 6: Times Grid -->
            <Label Grid.Row="5" Grid.Column="0" Text="Start Time (sec)" TextColor="{DynamicResource TextColor}" FontSize="14" Margin="0,6,0,0"/>
            <Border Grid.Row="6" Grid.Column="0" Margin="0,0,6,0" BackgroundColor="{DynamicResource SurfaceInput}" Stroke="{DynamicResource InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                <Entry Text="{Binding EditStartTime}" Keyboard="Numeric" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" HeightRequest="48"/>
            </Border>

            <Label Grid.Row="5" Grid.Column="1" Text="End Time (sec)" TextColor="{DynamicResource TextColor}" FontSize="14" Margin="0,6,0,0"/>
            <Border Grid.Row="6" Grid.Column="1" Margin="6,0,0,0" BackgroundColor="{DynamicResource SurfaceInput}" Stroke="{DynamicResource InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                <Entry Text="{Binding EditEndTime}" Keyboard="Numeric" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" HeightRequest="48"/>
            </Border>

            <!-- 7: Last Played -->
            <Label Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding LastPlayedText, StringFormat='Last Played: {0}'}" TextColor="{DynamicResource MutedColor}" FontSize="12" HorizontalOptions="Center" Margin="0,12,0,0">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding LastPlayedText}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

        </Grid>
    </ScrollView>
</ContentView>
