<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Musicthingy.Views.Dialogs.ColorPickerDialog"
               CanBeDismissedByTappingOutsideOfPopup="True"
               Padding="0"
               BackgroundColor="Transparent">

    <Border BackgroundColor="{DynamicResource CardColor}" StrokeThickness="0"
            StrokeShape="RoundRectangle 28" WidthRequest="320" Padding="24">

        <VerticalStackLayout Spacing="16">
            <Label Text="{Binding Title}" FontSize="24" TextColor="{DynamicResource TitleColor}" />
            <Label Text="{Binding Description}" FontSize="14" TextColor="{DynamicResource MutedColor}" />

            <!-- Selected Color Preview -->
            <Border x:Name="ColorPreview" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" />

            <!-- Hue Ring Picker -->
            <GraphicsView x:Name="HueWheelView" 
                          HeightRequest="200" WidthRequest="200" 
                          HorizontalOptions="Center"
                          StartInteraction="OnWheelInteraction"
                          DragInteraction="OnWheelInteraction" />

            <Entry x:Name="HexInput" TextChanged="OnHexInputChanged"
                   BackgroundColor="{DynamicResource SurfaceInput}" TextColor="{DynamicResource TextColor}" />

            <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Reset" Clicked="OnResetClicked" TextColor="{DynamicResource Danger}" BackgroundColor="Transparent" Padding="12,0"/>
                <Button Grid.Column="2" Text="Cancel" Clicked="OnCancelClicked" TextColor="{DynamicResource PrimaryButtonColor}" BackgroundColor="Transparent" Padding="12,0" />
                <Button Grid.Column="3" Text="OK" Clicked="OnOkClicked" TextColor="{DynamicResource PrimaryButtonText}" BackgroundColor="{DynamicResource PrimaryButtonColor}" Padding="16,0" CornerRadius="100"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>