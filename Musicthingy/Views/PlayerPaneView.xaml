<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
			 x:Class="Musicthingy.Views.PlayerPaneView">

    <Border Background="#161b22" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16" HeightRequest="350">
        <Grid RowDefinitions="Auto, Auto, *">

            <!-- Row 0: Header Area (Title + Tags) -->
            <VerticalStackLayout Grid.Row="0" Spacing="12" IsVisible="{Binding IsMediaSelected}">

                <!-- Title -->
                <Label Text="{Binding CurrentTrack.Title}" 
                       TextColor="#adcff0" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,4" />

                <!-- Tags Section -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">

                    <!-- Tag Button -->
                    <ImageButton Grid.Column="0"
                                 Source="tag_icon.png" 
                                 Style="{StaticResource IconImageButton}" 
                                 Padding="6" 
                                 VerticalOptions="Start"
                                 Margin="0,0,0,6"/>

                    <!-- Tags Area -->
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Tags:" Style="{StaticResource FormLabelStyle}" />

                        <!-- Tags List (Changed to a single Horizontal scrolling line so it NEVER wraps and pushes the player down) -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CurrentTrack.Tags}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{StaticResource TagBgColor}" 
                                                Stroke="{StaticResource AccentColor}" 
                                                StrokeThickness="1" 
                                                Padding="6,2,6,4" 
                                                Margin="0,0,2,4"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>

                                            <Label Text="{Binding .}" 
                                                   TextColor="{StaticResource TitleColor}" 
                                                   FontSize="12"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   LineBreakMode="NoWrap" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>

                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- Row 1: Player -->
            <Grid Grid.Row="1" HeightRequest="220" VerticalOptions="Start" Margin="0,0,0,16">
                <Border BackgroundColor="#0d1117" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid Margin="10,0,10,0">
                        <toolkit:MediaElement
							x:Name="MainPlayer"
							Source="{Binding CurrentMediaSource}"
							Position="{Binding CurrentPosition, Mode=OneWayToSource}"
							Duration="{Binding Duration, Mode=OneWayToSource}"
							ShouldAutoPlay="False"
							ShouldShowPlaybackControls="True"
							IsVisible="{Binding IsMediaSelected}"
							HeightRequest="220"
							HorizontalOptions="Fill"
							MediaEnded="MainPlayer_MediaEnded"
							MediaOpened="MainPlayer_MediaOpened"
							MetadataTitle="{Binding CurrentTrack.Title}"
                            MetadataArtist="{Binding SelectedPlaylist.Name}"/>
                    </Grid>
                </Border>

                <!-- Loading Overlay -->
                <Border BackgroundColor="#D9000000" StrokeThickness="0" IsVisible="{Binding IsLoadingMedia}" ZIndex="10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMedia}" Color="#adcff0" WidthRequest="35" HeightRequest="35"/>
                        <ProgressBar Progress="{Binding MediaDownloadProgress}" WidthRequest="200" HeightRequest="6" ProgressColor="#adcff0" />
                        <Label Text="Downloading Stream..." TextColor="#adcff0" FontSize="12" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Row 2: Lyrics -->
            <ScrollView Grid.Row="2" VerticalOptions="Fill">
                <Label Text="{Binding CurrentTrack.Lyrics}"
					   TextColor="#c9d1d9"
					   HorizontalOptions="Center" 
					   HorizontalTextAlignment="Center" 
					   VerticalOptions="Start"
					   Margin="10" 
					   FontSize="20"/>
            </ScrollView>

        </Grid>
    </Border>
</ContentView>