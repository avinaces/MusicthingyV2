<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:helpers="clr-namespace:Musicthingy.Helpers"
             xmlns:views="clr-namespace:Musicthingy.Views"
             x:Class="Musicthingy.Views.SettingsPage"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" HeightRequest="56" BackgroundColor="{DynamicResource BgColor}" ZIndex="10"
              Padding="8,0" ColumnDefinitions="44, *" ColumnSpacing="4">

            <ImageButton Grid.Column="0" Source="arrow_left_icon.png" Clicked="OnBackClicked" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="Transparent" Padding="8">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                </ImageButton.Behaviors>
            </ImageButton>

            <views:SearchBarView x:Name="SettingsSearchBar" Grid.Column="1" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1" x:Name="CategoriesList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto, *" Padding="24,20" ColumnSpacing="16" BackgroundColor="Transparent" helpers:AndroidRipple.AddRipple="True">
                        <Grid.GestureRecognizers>
                            <!-- We now bind the entire item object so we can read its Category enum in the tapped event -->
                            <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!-- Category Icon -->
                        <Image Grid.Column="0" Source="{Binding Icon}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                            </Image.Behaviors>
                        </Image>

                        <!-- Category Title -->
                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="18" TextColor="{DynamicResource TitleColor}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Settings search results. The top margin keeps the header/search bar usable. -->
        <views:SearchResultsView x:Name="SettingsSearchResults" Grid.RowSpan="2" ZIndex="60" Margin="0,56,0,0" />
    </Grid>
</ContentPage>