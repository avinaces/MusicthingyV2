<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:helpers="clr-namespace:Musicthingy.Helpers"
             x:Class="Musicthingy.Views.AboutPage"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Bar -->
        <Grid Grid.Row="0" HeightRequest="56" BackgroundColor="{DynamicResource BgColor}" ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ImageButton Grid.Column="0" Source="arrow_left_icon.png" Clicked="OnBackClicked" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="Transparent" Padding="8">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                </ImageButton.Behaviors>
            </ImageButton>

            <Label Grid.Column="1" Text="About" TextColor="{DynamicResource TitleColor}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1" x:Name="SectionsList" IsGrouped="True" SelectionMode="None">
            <!-- Hero: app identity + shortcuts -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="16,4,16,14" Spacing="12">
                    <Border Padding="18,16" BackgroundColor="{DynamicResource SurfacePanel}"
                            Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" VerticalOptions="Center"
                                        BackgroundColor="{DynamicResource AccentContainer}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14">
                                    <Image Source="music_4_icon.png" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{DynamicResource AccentColor}" />
                                        </Image.Behaviors>
                                    </Image>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Musicthingy" FontSize="22" FontAttributes="Bold"
                                           TextColor="{DynamicResource TitleColor}" />
                                    <Label x:Name="VersionLabel" FontSize="12"
                                           TextColor="{DynamicResource MutedColor}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="A Material 3 music player for YouTube and local files."
                                   FontSize="13" TextColor="{DynamicResource TextColor}" />

                            <HorizontalStackLayout Spacing="8">
                                <Border Padding="10,4" BackgroundColor="{DynamicResource AccentContainer}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                    <Label Text="GPL-3.0" FontSize="10" FontAttributes="Bold"
                                           CharacterSpacing="0.8" TextColor="{DynamicResource AccentColor}" />
                                </Border>
                                <Border Padding="10,4" BackgroundColor="{DynamicResource SurfaceRaised}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                    <Label Text="FREE SOFTWARE" FontSize="10" FontAttributes="Bold"
                                           CharacterSpacing="0.8" TextColor="{DynamicResource MutedColor}" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Shortcuts -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Padding="14,11" BackgroundColor="{DynamicResource SurfaceRaised}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                helpers:AndroidRipple.AddRipple="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenRepoClicked" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Image Source="external_link_icon.png" WidthRequest="15" HeightRequest="15"
                                       VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{DynamicResource TextColor}" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Text="Source code" FontSize="13" TextColor="{DynamicResource TextColor}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Padding="14,11" BackgroundColor="{DynamicResource SurfaceRaised}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                helpers:AndroidRipple.AddRipple="True">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenAppLicenseClicked" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Image Source="book_open_text_icon.png" WidthRequest="15" HeightRequest="15"
                                       VerticalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{DynamicResource TextColor}" />
                                    </Image.Behaviors>
                                </Image>
                                <Label Text="License" FontSize="13" TextColor="{DynamicResource TextColor}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Section headers -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Title}" Padding="20,18,20,8"
                           FontSize="11" FontAttributes="Bold" CharacterSpacing="1.4"
                           TextColor="{DynamicResource MutedColor}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- Library / asset rows -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="16,0,16,8" Padding="14"
                            BackgroundColor="{DynamicResource SurfacePanel}"
                            Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            helpers:AndroidRipple.AddRipple="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEntryTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Center"
                                    BackgroundColor="{DynamicResource AccentContainer}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Label Text="{Binding BadgeText}" FontSize="12" FontAttributes="Bold"
                                       CharacterSpacing="0.5" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{DynamicResource AccentColor}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="15" TextColor="{DynamicResource TitleColor}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label Text="{Binding Summary}" FontSize="12"
                                       TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Border Padding="8,3" BackgroundColor="{DynamicResource SurfaceRaised}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                        HorizontalOptions="End">
                                    <Label Text="{Binding License.Id}" FontSize="9" FontAttributes="Bold"
                                           CharacterSpacing="0.6" TextColor="{DynamicResource MutedColor}" />
                                </Border>
                                <Label Text="{Binding VersionLabel}" FontSize="10"
                                       TextColor="{DynamicResource MutedColor}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Label Padding="20,10,20,26" FontSize="11" LineHeight="1.4"
                       TextColor="{DynamicResource MutedColor}"
                       Text="Every license is bundled with the app, so this page works offline. Tap a row for the full text and the project it comes from." />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
