<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Musicthingy.Views"
             x:Class="Musicthingy.Views.EditTrackSheet"
             BackgroundColor="Transparent">

    <local:BottomSheetContainer Title="Edit Track" CloseRequested="OnCloseRequested">
        <local:BottomSheetContainer.Body>

            <Grid RowDefinitions="Auto, *">

                <!-- Segmented Tab Bar -->
                <local:SegmentedTabBar Grid.Row="0" Tabs="Track, Lyrics, Tags" SelectedIndexChanged="OnTabChanged" Margin="0,0,0,16" />

                <!-- Fixed minimum height prevents the bottom sheet from resizing wildly when switching tabs -->
                <Grid Grid.Row="1" MinimumHeightRequest="500">
                    <local:EditTrackGeneralTab x:Name="GeneralTab" />
                    <local:EditTrackLyricsTab x:Name="LyricsTab" IsVisible="False" />
                    <local:EditTrackTagsTab x:Name="TagsTab" IsVisible="False" />
                </Grid>

            </Grid>

        </local:BottomSheetContainer.Body>

        <local:BottomSheetContainer.Footer>
            <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="{DynamicResource SecondaryButtonColor}" TextColor="{DynamicResource SecondaryButtonText}" BorderColor="{DynamicResource SecondaryButtonBorder}" BorderWidth="1" CornerRadius="8" HeightRequest="44" Padding="16,0" />
                <Button Text="Save" Clicked="OnSaveClicked" BackgroundColor="{DynamicResource PrimaryButtonColor}" TextColor="{DynamicResource PrimaryButtonText}" CornerRadius="8" HeightRequest="44" Padding="24,0" />
            </HorizontalStackLayout>
        </local:BottomSheetContainer.Footer>
    </local:BottomSheetContainer>
</ContentView>
