<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Musicthingy.Views.EditLyricsPopup"
               x:TypeArguments="x:Boolean"
               CanBeDismissedByTappingOutsideOfPopup="False"
               BackgroundColor="Transparent"
               Padding="0">

    <Border x:Name="RootBorder"
            BackgroundColor="#0d1117" 
            Stroke="#30363d" 
            StrokeThickness="1" 
            StrokeShape="RoundRectangle 12" 
            WidthRequest="{OnIdiom Desktop=700}" 
            MaximumHeightRequest="{OnIdiom Desktop=800}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="0"
            Padding="0">

        <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20, 24, 20, 20">

            <!-- Title -->
            <Label Grid.Row="0" Text="Edit Lyrics" TextColor="#adcff0" FontSize="22" FontAttributes="Bold" Margin="0,0,0,16" />

            <!-- Search Box Area -->
            <Border Grid.Row="1" BackgroundColor="#161b22" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,0,0,16">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Search Online (Auto)" Command="{Binding SearchOnlineCommand}" BackgroundColor="{DynamicResource SwipeEditColor}" TextColor="White" CornerRadius="8" HeightRequest="48"/>

                        <ImageButton Grid.Column="1" Source="settings_icon.png" Command="{Binding ToggleAdvancedCommand}" WidthRequest="48" HeightRequest="48" BackgroundColor="#30363d" CornerRadius="8" Padding="12">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding IsAdvancedOpen}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SwipeEditColor}"/>
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </Grid>

                    <!-- Advanced Fields -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdvancedOpen}">
                        <BoxView HeightRequest="1" Color="#30363d" Margin="0,4"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Title" TextColor="#c9d1d9" FontSize="14"/>
                                <Border BackgroundColor="#0d1117" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                                    <Entry Text="{Binding SearchTitle}" TextColor="White" BackgroundColor="Transparent" HeightRequest="48"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Artist" TextColor="#c9d1d9" FontSize="14"/>
                                <Border BackgroundColor="#0d1117" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                                    <Entry Text="{Binding SearchArtist}" TextColor="White" BackgroundColor="Transparent" HeightRequest="48"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Preferred Format" TextColor="#c9d1d9" FontSize="14"/>
                            <Border Stroke="#30363d" StrokeThickness="1" BackgroundColor="#0d1117" StrokeShape="RoundRectangle 8" Padding="12,0">
                                <Picker SelectedItem="{Binding SearchType}" TextColor="White" Title="Select Format...">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Timed Lyrics (LRC)</x:String>
                                            <x:String>Plain Text (Untimed)</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsSearching}" Color="{DynamicResource AccentColor}" HeightRequest="24" IsVisible="{Binding IsSearching}" Margin="0,4,0,0"/>

                </VerticalStackLayout>
            </Border>

            <!-- Editor Zone -->
            <Border Grid.Row="2" BackgroundColor="#161b22" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0">
                <Editor x:Name="LyricsEditor" Text="{Binding LyricsText}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Fill" HorizontalOptions="Fill" Margin="12" FontSize="14" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"/>
            </Border>

            <!-- Actions -->
            <HorizontalStackLayout Grid.Row="3" HorizontalOptions="End" Spacing="12" Margin="0,16,0,0">
                <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="#161b22" TextColor="White" BorderColor="#30363d" BorderWidth="1" CornerRadius="8" HeightRequest="44" Padding="16,0" />
                <Button Text="Save" Clicked="OnSaveClicked" BackgroundColor="{DynamicResource SwipeEditColor}" TextColor="White" CornerRadius="8" HeightRequest="44" Padding="24,0" />
            </HorizontalStackLayout>

        </Grid>
    </Border>
</toolkit:Popup>