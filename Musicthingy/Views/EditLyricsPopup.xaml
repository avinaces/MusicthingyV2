<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Musicthingy.Views.EditLyricsPopup"
               x:TypeArguments="x:String"
               CanBeDismissedByTappingOutsideOfPopup="False"
               BackgroundColor="Transparent">

    <Border BackgroundColor="#0d1117" 
            Stroke="{StaticResource BorderColor}" 
            StrokeThickness="{OnIdiom Phone=0, Desktop=1}"
            WidthRequest="{OnIdiom Phone=-1, Desktop=700}" 
            HeightRequest="{OnIdiom Phone=-1, Desktop=800}"
            HorizontalOptions="{OnIdiom Phone=Fill, Desktop=Center}"
            VerticalOptions="{OnIdiom Phone=Fill, Desktop=Center}"
            Margin="0"
            Padding="0">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{OnIdiom Phone=0, Desktop=12}" />
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto, Auto, *">

            <!-- 1. NAVBAR -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" BackgroundColor="#161b22" Padding="10,15,10,15">
                <Button Grid.Column="0" Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="{StaticResource MutedColor}" FontSize="16" Padding="10,0"/>
                <Label Grid.Column="1" Text="Edit Lyrics" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TitleColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Button Grid.Column="2" Text="Save" Command="{Binding SaveCommand}" BackgroundColor="Transparent" TextColor="#58a6ff" FontAttributes="Bold" FontSize="16" Padding="10,0"/>
            </Grid>

            <!-- 2. SEARCH & ADVANCED OPTIONS -->
            <Border Grid.Row="1" BackgroundColor="#1c2128" StrokeThickness="0" Padding="16,12" Margin="0,0,0,8">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <Button Grid.Column="0" Text="Search Online (Auto)" Command="{Binding SearchCommand}" Style="{StaticResource PopupPrimaryButtonStyle}" HeightRequest="44"/>
                        <ImageButton Grid.Column="1" Source="settings_icon.png" Command="{Binding ToggleAdvancedCommand}" WidthRequest="44" HeightRequest="44" BackgroundColor="#30363d" CornerRadius="8" Padding="10">
                            <ImageButton.Triggers>
                                <DataTrigger TargetType="ImageButton" Binding="{Binding IsAdvancedOpen}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#58a6ff"/>
                                </DataTrigger>
                            </ImageButton.Triggers>
                        </ImageButton>
                    </Grid>

                    <!-- Advanced Dropdown Content -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdvancedOpen}">
                        <BoxView HeightRequest="1" Color="#30363d" Margin="0,4"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Title" Style="{StaticResource FormLabelStyle}"/>
                                <Entry Text="{Binding SearchTitle}" Style="{StaticResource FormEntryStyle}" HeightRequest="44"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Artist" Style="{StaticResource FormLabelStyle}"/>
                                <Entry Text="{Binding SearchArtist}" Style="{StaticResource FormEntryStyle}" HeightRequest="44"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Preferred Format" Style="{StaticResource FormLabelStyle}"/>
                            <Border Stroke="{StaticResource BorderColor}" StrokeThickness="1" BackgroundColor="#0d1117" StrokeShape="RoundRectangle 8">
                                <Picker SelectedItem="{Binding SearchType}" TextColor="{StaticResource TitleColor}" Title="Select Format..." Margin="5,0">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Timed Lyrics (LRC)</x:String>
                                            <x:String>Plain Text (Untimed)</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsSearching}" Color="#58a6ff" HeightRequest="24" IsVisible="{Binding IsSearching}" Margin="0,4,0,0"/>

                </VerticalStackLayout>
            </Border>

            <!-- 3. EDITOR ZONE -->
            <Grid Grid.Row="2" Padding="16,0,16,16">
                <Border BackgroundColor="#0d1117" 
                        Stroke="{StaticResource BorderColor}" 
                        StrokeThickness="1" 
                        StrokeShape="RoundRectangle 8"
                        Padding="0">

                    <Editor x:Name="LyricsEditor"
                            Text="{Binding LyricsText}"
                            TextColor="{StaticResource TitleColor}"
                            BackgroundColor="Transparent"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill"
                            Margin="8"
                            FontSize="14"
                            IsTextPredictionEnabled="False"
                            IsSpellCheckEnabled="False"/>
                </Border>
            </Grid>

        </Grid>
    </Border>
</toolkit:Popup>