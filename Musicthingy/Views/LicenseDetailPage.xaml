<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Musicthingy.Views.LicenseDetailPage"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Bar -->
        <Grid Grid.Row="0" HeightRequest="56" BackgroundColor="{DynamicResource BgColor}" ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ImageButton Grid.Column="0" Source="arrow_left_icon.png" Clicked="OnBackClicked" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" HorizontalOptions="Center" BackgroundColor="Transparent" Padding="8">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{DynamicResource TitleColor}" />
                </ImageButton.Behaviors>
            </ImageButton>

            <Label Grid.Column="1" Text="License" TextColor="{DynamicResource TitleColor}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,28" Spacing="12">

                <!-- Component header -->
                <Border Padding="18,16" BackgroundColor="{DynamicResource SurfacePanel}"
                        Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" VerticalOptions="Center"
                                    BackgroundColor="{DynamicResource AccentContainer}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <Label x:Name="BadgeLabel" FontSize="14" FontAttributes="Bold"
                                       CharacterSpacing="0.5" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{DynamicResource AccentColor}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="NameLabel" FontSize="19" FontAttributes="Bold"
                                       TextColor="{DynamicResource TitleColor}" />
                                <Label x:Name="MetaLabel" FontSize="12"
                                       TextColor="{DynamicResource MutedColor}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="SummaryLabel" FontSize="13" LineHeight="1.35"
                               TextColor="{DynamicResource TextColor}" />

                        <Label x:Name="CopyrightLabel" FontSize="11"
                               TextColor="{DynamicResource MutedColor}" />

                        <HorizontalStackLayout Spacing="8">
                            <Border Padding="10,4" BackgroundColor="{DynamicResource AccentContainer}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                <Label x:Name="LicenseChipLabel" FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="0.8" TextColor="{DynamicResource AccentColor}" />
                            </Border>
                            <Border x:Name="PackageCountChip" IsVisible="False" Padding="10,4"
                                    BackgroundColor="{DynamicResource SurfaceRaised}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                <Label x:Name="PackageCountLabel" FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="0.8" TextColor="{DynamicResource MutedColor}" />
                            </Border>
                        </HorizontalStackLayout>

                        <Grid x:Name="LinkButtons" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="ProjectButton" Grid.Column="0" Text="Project page"
                                    Clicked="OnProjectClicked" FontSize="13" HeightRequest="42" CornerRadius="10"
                                    Padding="8,0" BackgroundColor="{DynamicResource SurfaceRaised}"
                                    TextColor="{DynamicResource TextColor}" BorderWidth="0" />
                            <Button x:Name="LicenseButton" Grid.Column="1" Text="License online"
                                    Clicked="OnLicenseClicked" FontSize="13" HeightRequest="42" CornerRadius="10"
                                    Padding="8,0" BackgroundColor="{DynamicResource SurfaceRaised}"
                                    TextColor="{DynamicResource TextColor}" BorderWidth="0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Bundled packages (transitive dependency group only) -->
                <VerticalStackLayout x:Name="PackagesSection" IsVisible="False" Spacing="8">
                    <Label Text="PACKAGES" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.4"
                           TextColor="{DynamicResource MutedColor}" Margin="4,6,0,0" />

                    <Border Padding="0" BackgroundColor="{DynamicResource SurfacePanel}"
                            Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout x:Name="PackagesList" Spacing="0"
                                             BindableLayout.ItemsSource="{Binding Packages}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="14,10" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Name}" FontSize="13"
                                                   TextColor="{DynamicResource TitleColor}"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Label Text="{Binding Note}" FontSize="10"
                                                   TextColor="{DynamicResource MutedColor}"
                                                   IsVisible="{Binding HasNote}"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding LicenseId}" FontSize="10" FontAttributes="Bold"
                                                   CharacterSpacing="0.5" HorizontalOptions="End"
                                                   TextColor="{DynamicResource AccentColor}" />
                                            <Label Text="{Binding Version}" FontSize="9"
                                                   TextColor="{DynamicResource MutedColor}"
                                                   HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="PackageLegendLabel" FontSize="10" LineHeight="1.3"
                           TextColor="{DynamicResource MutedColor}"
                           Text="Packages with two licenses ship a MIT-licensed .NET binding around an Apache-2.0 Android library." />
                </VerticalStackLayout>

                <!-- License texts: one block per license (a group can bundle several) -->
                <VerticalStackLayout x:Name="LicenseTextsSection" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Header}" FontSize="11" FontAttributes="Bold"
                                       CharacterSpacing="1.4" TextColor="{DynamicResource MutedColor}"
                                       Margin="4,12,0,0" />
                                <Border Padding="14" BackgroundColor="{DynamicResource SurfacePanel}"
                                        Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">
                                    <Label Text="{Binding Text}" FontSize="12" LineHeight="1.35"
                                           TextColor="{DynamicResource TextColor}" />
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
