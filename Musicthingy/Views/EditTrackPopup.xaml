<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Musicthingy.Views.EditTrackPopup"
               x:TypeArguments="x:Boolean"
               CanBeDismissedByTappingOutsideOfPopup="True"
               BackgroundColor="Transparent"
               Padding="0"
               Margin="0">

    <Border BackgroundColor="{StaticResource CardColor}" 
            Stroke="{StaticResource BorderColor}" 
            StrokeThickness="1" 
            StrokeShape="RoundRectangle 12" 
            WidthRequest="450" 
            MaximumHeightRequest="750"
            Padding="0">

        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="16">

                <Label Text="Edit Track" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TitleColor}" Margin="0,0,0,8" />

                <!-- Title -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Title" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding EditTitle}" Style="{StaticResource FormEntryStyle}" IsSpellCheckEnabled="True"/>
                </VerticalStackLayout>

                <!-- URL -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="URL" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding EditUrl}" Style="{StaticResource FormEntryStyle}"/>
                </VerticalStackLayout>

                <!-- Start / End Time -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Start (seconds)" Style="{StaticResource FormLabelStyle}" />
                        <Entry Text="{Binding EditStartTime}" Keyboard="Numeric" Style="{StaticResource FormEntryStyle}"  />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="End (seconds)" Style="{StaticResource FormLabelStyle}" />
                        <Entry Text="{Binding EditEndTime}" Keyboard="Numeric" Style="{StaticResource FormEntryStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Icon -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Icon" Style="{StaticResource FormLabelStyle}" />
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Image Source="{Binding ItemIconSource}" WidthRequest="48" HeightRequest="48" Aspect="AspectFill">
                            <Image.Clip>
                                <RoundRectangleGeometry CornerRadius="8" Rect="0,0,48,48"/>
                            </Image.Clip>
                        </Image>
                        <!-- Uses the new unified global style without local overrides -->
                        <Button Text="Reset" Style="{StaticResource PopupSecondaryButtonStyle}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Tags -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Tags" Style="{StaticResource FormLabelStyle}" />

                    <!-- Dynamic Bindable Layout for Tags -->
                    <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding Tags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{StaticResource TagBgColor}" 
                                        Stroke="{StaticResource AccentColor}" 
                                        StrokeThickness="1" 
                                        Padding="8,4" 
                                        Margin="0,0,2,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding .}" TextColor="{StaticResource TitleColor}" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <ImageButton Source="tag_icon.png" Style="{StaticResource IconImageButton}" Padding="6" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Last Played -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Last Played:" Style="{StaticResource FormLabelStyle}" />
                    <Label Text="{Binding LastPlayedText}" TextColor="{StaticResource MutedColor}" />
                </VerticalStackLayout>

                <!-- Lyrics -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Lyrics" Style="{StaticResource FormLabelStyle}" />
                    <Button Text="Edit Lyrics" Style="{StaticResource PopupSecondaryButtonStyle}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Actions -->
                <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,16,0,0">
                    <Button Text="Cancel" Clicked="OnCancelClicked" Style="{StaticResource PopupSecondaryButtonStyle}" />
                    <Button Text="Save" Clicked="OnSaveClicked" Style="{StaticResource PopupPrimaryButtonStyle}" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Border>
</toolkit:Popup>