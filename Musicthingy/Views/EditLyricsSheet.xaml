<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Musicthingy.Views"
             x:Class="Musicthingy.Views.EditLyricsSheet"
             BackgroundColor="Transparent">

    <local:BottomSheetContainer Title="Edit Lyrics" CloseRequested="OnCloseRequested">
        <local:BottomSheetContainer.Body>

            <Grid RowDefinitions="Auto, *">
                <Border Grid.Row="0" BackgroundColor="#161b22" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="Search Online (Auto)" Command="{Binding SearchOnlineCommand}" BackgroundColor="#2d5b8c" TextColor="White" CornerRadius="8" HeightRequest="48"/>

                            <ImageButton Grid.Column="1" Source="settings_icon.png" Command="{Binding ToggleAdvancedCommand}" WidthRequest="48" HeightRequest="48" BackgroundColor="#30363d" CornerRadius="8" Padding="12">
                                <ImageButton.Triggers>
                                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsAdvancedOpen}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#2d5b8c"/>
                                    </DataTrigger>
                                </ImageButton.Triggers>
                            </ImageButton>
                        </Grid>

                        <VerticalStackLayout Spacing="12" IsVisible="{Binding IsAdvancedOpen}">
                            <BoxView HeightRequest="1" Color="#30363d" Margin="0,4"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="Title" TextColor="#c9d1d9" FontSize="14"/>
                                    <Border BackgroundColor="#0d1117" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                                        <Entry Text="{Binding SearchTitle}" TextColor="White" BackgroundColor="Transparent" HeightRequest="48"/>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Artist" TextColor="#c9d1d9" FontSize="14"/>
                                    <Border BackgroundColor="#0d1117" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                                        <Entry Text="{Binding SearchArtist}" TextColor="White" BackgroundColor="Transparent" HeightRequest="48"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Preferred Format" TextColor="#c9d1d9" FontSize="14"/>
                                <Border Stroke="#30363d" StrokeThickness="1" BackgroundColor="#0d1117" StrokeShape="RoundRectangle 8" Padding="12,0">
                                    <Picker SelectedItem="{Binding SearchType}" TextColor="White" Title="Select Format...">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Timed Lyrics (LRC)</x:String>
                                                <x:String>Plain Text (Untimed)</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <ActivityIndicator IsRunning="{Binding IsSearching}" Color="#58a6ff" HeightRequest="24" IsVisible="{Binding IsSearching}" Margin="0,4,0,0"/>

                    </VerticalStackLayout>
                </Border>

                <!-- This row naturally expands to fill the leftover vertical space -->
                <Border Grid.Row="1" BackgroundColor="#161b22" Stroke="#30363d" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0">
                    <Editor x:Name="LyricsEditor" Text="{Binding LyricsText}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Fill" HorizontalOptions="Fill" Margin="12" FontSize="14" IsTextPredictionEnabled="False" IsSpellCheckEnabled="False"/>
                </Border>
            </Grid>

        </local:BottomSheetContainer.Body>

        <local:BottomSheetContainer.Footer>
            <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="#21262d" TextColor="White" BorderColor="#30363d" BorderWidth="1" CornerRadius="8" HeightRequest="44" Padding="16,0" />
                <Button Text="Save" Clicked="OnSaveClicked" BackgroundColor="#2d5b8c" TextColor="White" CornerRadius="8" HeightRequest="44" Padding="24,0" />
            </HorizontalStackLayout>
        </local:BottomSheetContainer.Footer>

    </local:BottomSheetContainer>
</ContentView>