<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Musicthingy.Views"
             x:Class="Musicthingy.Views.ContextMenuSheet"
             x:Name="Root">

    <views:BottomSheetContainer x:Name="InnerSheet" Title="{Binding MenuTitle, Source={x:Reference Root}}" CloseRequested="OnSheetCloseRequested">
        <views:BottomSheetContainer.Body>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MenuItems, Source={x:Reference Root}}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="views:ContextMenuItem">
                        <Grid HeightRequest="56" BackgroundColor="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuItemTapped" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Image Source="{Binding IconSource}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Title}" TextColor="{Binding TextColor}" FontSize="16" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </views:BottomSheetContainer.Body>
    </views:BottomSheetContainer>
</ContentView>