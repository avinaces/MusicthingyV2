<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Musicthingy.Views"
             x:Class="Musicthingy.Views.EditPlaylistSheet"
             BackgroundColor="Transparent">

    <local:BottomSheetContainer Title="Edit Playlist" CloseRequested="OnCloseRequested">
        <local:BottomSheetContainer.Body>

            <Grid RowDefinitions="Auto, *">

                <!-- Segmented Tab Bar -->
                <local:SegmentedTabBar Grid.Row="0" Tabs="Playlist, Tags" SelectedIndexChanged="OnTabChanged" Margin="0,0,0,16" />

                <!-- Fixed minimum height prevents the bottom sheet from resizing wildly -->
                <Grid Grid.Row="1" MinimumHeightRequest="500">
                    <local:EditPlaylistGeneralTab x:Name="GeneralTab" />
                    <!-- Completely reusing the Track Tags view logic here! -->
                    <local:EditTrackTagsTab x:Name="TagsTab" IsVisible="False" />
                </Grid>

            </Grid>

        </local:BottomSheetContainer.Body>

        <local:BottomSheetContainer.Footer>
            <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="{DynamicResource SurfaceRaised}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="8" HeightRequest="44" Padding="16,0" />
                <Button Text="Save" Clicked="OnSaveClicked" BackgroundColor="{DynamicResource AccentFill}" TextColor="{DynamicResource OnAccent}" CornerRadius="8" HeightRequest="44" Padding="24,0" />
            </HorizontalStackLayout>
        </local:BottomSheetContainer.Footer>
    </local:BottomSheetContainer>
</ContentView>
