<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                         x:Class="Musicthingy.Views.MobilePlayerPaneView"
                         xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                         xmlns:models="clr-namespace:Musicthingy.Models"
                         xmlns:views="clr-namespace:Musicthingy.Views"
                         xmlns:helpers="clr-namespace:Musicthingy.Helpers">

        <Border x:Name="PlayerRoot" 
                        Background="{DynamicResource CardColor}" 
                        Stroke="{DynamicResource BorderColor}" 
                        StrokeThickness="1" 
                        Margin="-1,0,0,-2"
                        Padding="0"
                        VerticalOptions="End"
                        HeightRequest="72"
                        IsVisible="{Binding IsMediaSelected}">

                <Border.GestureRecognizers>
                        <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16,16,0,0" />
                </Border.StrokeShape>

                <!-- NO RowDefinitions. They overlap and are manually pushed down by TranslationY -->
                <Grid BackgroundColor="Transparent">

                        <!-- ========================================== -->
                        <!-- 2. EXPANDED ZONE (Moved above HeaderDragZone so it draws Underneath it.
                             Height is sized in code-behind as paneHeight - headerShift so its
                             BOTTOM lands exactly on the pane's bottom edge when fully expanded -
                             previously it used the full pane height and overshot off screen,
                             pushing the lyrics + scrollbar below the screen edge) -->
                        <!-- ========================================== -->
                        <Grid x:Name="ExpandedContentZone" VerticalOptions="Start" Padding="16,10,16,16" IsVisible="False" Opacity="0">
                                <VerticalStackLayout Spacing="12">

                                        <HorizontalStackLayout x:Name="TagsRow" Spacing="4" Margin="0,-10,0,-4">

                                                <ScrollView Orientation="Horizontal"
                                                            HorizontalScrollBarVisibility="Never" VerticalOptions="Center">

                                                        <HorizontalStackLayout
                                                                BindableLayout.ItemsSource="{Binding CurrentTrack.Tags}"
                                                                Spacing="4" VerticalOptions="Center" HeightRequest="28">

                                                                <!-- Add Tags Button (EmptyView) -->
                                                                <BindableLayout.EmptyView>
                                                                        <Button Text="+ Add Tags"
                                                                                Command="{Binding OpenTagsCommand, Source={RelativeSource AncestorType={x:Type views:MobilePlayerPaneView}}}"
                                                                                CommandParameter="{Binding BindingContext.CurrentTrack, Source={x:Reference PlayerRoot}}"
                                                                                TextColor="{DynamicResource MutedColor}"
                                                                                BackgroundColor="Transparent"
                                                                                BorderColor="{DynamicResource BorderColor}"
                                                                                BorderWidth="1"
                                                                                CornerRadius="8"
                                                                                Padding="10,0"
                                                                                FontSize="12"
                                                                                VerticalOptions="Center"
                                                                                MinimumHeightRequest="0"
                                                                                HeightRequest="26" />
                                                                </BindableLayout.EmptyView>

                                                                <!-- Individual Tags -->
                                                                <BindableLayout.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                                <Button Text="{Binding .}"
                                                                                        Command="{Binding OpenTagsCommand, Source={RelativeSource AncestorType={x:Type views:MobilePlayerPaneView}}}"
                                                                                        CommandParameter="{Binding BindingContext.CurrentTrack, Source={x:Reference PlayerRoot}}"
                                                                                        TextColor="{DynamicResource TagTextColor}"
                                                                                        BackgroundColor="{DynamicResource TagBgColor}"
                                                                                        BorderColor="{DynamicResource AccentColor}"
                                                                                        BorderWidth="1"
                                                                                        CornerRadius="6"
                                                                                        Padding="10,0"
                                                                                        FontSize="12"
                                                                                        VerticalOptions="Center"
                                                                                        MinimumHeightRequest="0"
                                                                                        MinimumWidthRequest="0"
                                                                                        HeightRequest="22" />
                                                                        </DataTemplate>
                                                                </BindableLayout.ItemTemplate>

                                                        </HorizontalStackLayout>

                                                </ScrollView>

                                        </HorizontalStackLayout>

                                        <!-- M3 media area: the cover art, or the lyrics view once the
                                             Lyrics pill opens it. Both share one slot, so the controls
                                             below never move between the two modes. The slot height is
                                             computed in code-behind from the visible part of the pane:
                                             collapsed (medium) it is zero, at full screen it absorbs all
                                             the space left between the tags row and the controls. -->
                                        <Grid x:Name="MediaSlot" HeightRequest="0" IsVisible="False">
                                                <Border x:Name="ArtworkCard"
                                                        BackgroundColor="{DynamicResource SurfaceRaised}"
                                                        StrokeThickness="0" IsVisible="False"
                                                        HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="20" />
                                                        </Border.StrokeShape>
                                                        <Image Source="{Binding CurrentTrack.ItemIconSource}" Aspect="AspectFill" />
                                                </Border>

                                                <views:LyricsView x:Name="LyricsZone" IsVisible="False" />
                                        </Grid>

                                        <!-- Slider / transport / bottom actions. -->
                                        <VerticalStackLayout x:Name="ExpandedControls" Spacing="8">

                                                <VerticalStackLayout Spacing="0" Margin="0,0,0,-10">

                                                        <Slider
                                                                Minimum="0"
                                                                Maximum="{Binding DurationSeconds}"
                                                                Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                                                                DragStartedCommand="{Binding DragStartedCommand}"
                                                                DragCompletedCommand="{Binding SeekCommand}"
                                                                Margin="0,-4,0,0"/>

                                                        <Grid ColumnDefinitions="*,*" Margin="4,-2,4,0">

                                                                <Label Text="{Binding CurrentPosition, StringFormat='{0:mm\\:ss}'}" FontSize="10" Opacity="0.7"/>

                                                                <Label Grid.Column="1" HorizontalTextAlignment="End" Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}" FontSize="10" Opacity="0.7" Margin="0,0,1,0"/>

                                                        </Grid>

                                                </VerticalStackLayout>

                                                <!-- M3 transport row: tonal 48dp side buttons around a 72dp
                                                     near-white play container. -->
                                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,4,0,0">

                                                        <ImageButton x:Name="ShuffleBtn"
                                                                Source="{Binding ShuffleIconSource}"
                                                                Command="{Binding ToggleShuffleCommand}"
                                                                BackgroundColor="{DynamicResource SurfaceRaised}"
                                                                CornerRadius="16" WidthRequest="48" HeightRequest="48" Padding="12">
                                                                <ImageButton.Behaviors>
                                                                        <toolkit:IconTintColorBehavior BindingContext="{Binding BindingContext, Source={x:Reference ShuffleBtn}}" TintColor="{Binding ShuffleIconColor}" />
                                                                </ImageButton.Behaviors>
                                                        </ImageButton>

                                                        <ImageButton Source="skip_back_icon.png" Command="{Binding PlayPreviousCommand}" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource SurfaceRaised}" Padding="12" CornerRadius="16" />

                                                        <Border Background="{DynamicResource PlayButtonColor}" StrokeThickness="0" WidthRequest="72" HeightRequest="72">
                                                                <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="24" />
                                                                </Border.StrokeShape>

                                                                <Grid>
                                                                        <!-- M3 play container: near-white, low-chroma fill with a
                                                                             near-black tinted glyph (PlayButtonColor / PlayButtonIconColor). -->
                                                                        <ImageButton x:Name="PlayPauseBtn"
                                                                                Source="{Binding PlayPauseIcon}"
                                                                                Command="{Binding TogglePlayCommand}"
                                                                                WidthRequest="72" HeightRequest="72"
                                                                                BackgroundColor="Transparent" Padding="20">
                                                                                <ImageButton.Behaviors>
                                                                                        <toolkit:IconTintColorBehavior BindingContext="{Binding BindingContext, Source={x:Reference PlayPauseBtn}}" TintColor="{Binding PlayPauseIconColor}" />
                                                                                </ImageButton.Behaviors>
                                                                        </ImageButton>

                                                                        <!-- Loading overlay: repaint the container so the glyph does
                                                                             not show behind the spinner, which uses the same on-color. -->
                                                                        <Grid BackgroundColor="{DynamicResource PlayButtonColor}" IsVisible="{Binding IsLoadingMedia}">
                                                                                <ActivityIndicator IsRunning="{Binding IsLoadingMedia}" Color="{Binding PlayPauseIconColor}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                                                        </Grid>
                                                                </Grid>
                                                        </Border>

                                                        <ImageButton Source="skip_forward_icon.png" Command="{Binding PlayNextCommand}" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource SurfaceRaised}" Padding="12" CornerRadius="16"/>

                                                        <ImageButton x:Name="RepeatBtn"
                                                                Source="{Binding RepeatIconSource}"
                                                                Command="{Binding ToggleRepeatCommand}"
                                                                BackgroundColor="{DynamicResource SurfaceRaised}"
                                                                CornerRadius="16" WidthRequest="48" HeightRequest="48" Padding="12">
                                                                <ImageButton.Behaviors>
                                                                        <toolkit:IconTintColorBehavior BindingContext="{Binding BindingContext, Source={x:Reference RepeatBtn}}" TintColor="{Binding RepeatIconColor}" />
                                                                </ImageButton.Behaviors>
                                                        </ImageButton>

                                                </HorizontalStackLayout>

                                                <!-- M3 bottom actions: two tonal pills. Lyrics swaps the
                                                     media slot between artwork and lyrics. Queue is a
                                                     placeholder for the queue UI that comes next. -->
                                                <Grid x:Name="BottomActions" ColumnDefinitions="*,*" ColumnSpacing="12"
                                                      Opacity="0" InputTransparent="True" Margin="0,4,0,0">

                                                        <Border x:Name="QueuePill" Grid.Column="0" BackgroundColor="{DynamicResource SurfaceRaised}" StrokeThickness="0" HeightRequest="48">
                                                                <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="24" />
                                                                </Border.StrokeShape>
                                                                <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnQueueClicked" />
                                                                </Border.GestureRecognizers>
                                                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                                                        <Image Source="list_music_icon.png" WidthRequest="20" HeightRequest="20">
                                                                                <Image.Behaviors>
                                                                                        <toolkit:IconTintColorBehavior TintColor="{Binding Source={x:Reference QueueLabel}, Path=TextColor}" />
                                                                                </Image.Behaviors>
                                                                        </Image>
                                                                        <Label x:Name="QueueLabel" Text="Queue" FontSize="14" VerticalOptions="Center" TextColor="{DynamicResource TitleColor}" />
                                                                </HorizontalStackLayout>
                                                        </Border>

                                                        <Border x:Name="LyricsPill" Grid.Column="1" BackgroundColor="{DynamicResource SurfaceRaised}" StrokeThickness="0" HeightRequest="48">
                                                                <Border.StrokeShape>
                                                                        <RoundRectangle CornerRadius="24" />
                                                                </Border.StrokeShape>
                                                                <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnLyricsToggleClicked" />
                                                                </Border.GestureRecognizers>
                                                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                                                        <Image Source="text_align_start_icon.png" WidthRequest="20" HeightRequest="20">
                                                                                <Image.Behaviors>
                                                                                        <toolkit:IconTintColorBehavior TintColor="{Binding Source={x:Reference LyricsLabel}, Path=TextColor}" />
                                                                                </Image.Behaviors>
                                                                        </Image>
                                                                        <Label x:Name="LyricsLabel" Text="Lyrics" FontSize="14" VerticalOptions="Center" TextColor="{DynamicResource TitleColor}" />
                                                                </HorizontalStackLayout>
                                                        </Border>
                                                </Grid>
                                        </VerticalStackLayout>
                                </VerticalStackLayout>
                        </Grid>

                        <!-- ========================================== -->
                        <!-- 1. DRAG ZONE (VerticalOptions=Start locks the height and acts freely over the List bounds) -->
                        <!-- ========================================== -->
                        <Grid x:Name="HeaderDragZone" BackgroundColor="Transparent" Padding="0" VerticalOptions="Start">

                                <RoundRectangle x:Name="DragHandle" 
                                                                Fill="{DynamicResource DragHandleColor}" WidthRequest="36" HeightRequest="5" 
                                                                CornerRadius="2.5" HorizontalOptions="Center" VerticalOptions="Start"
                                                                Margin="0,12,0,0" IsVisible="False" Opacity="0" />

                                <Grid x:Name="HeaderContentGrid" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Margin="16,14,16,14">

                                        <Border x:Name="TrackImageBorder" Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="7" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding CurrentTrack.ItemIconSource}" Aspect="AspectFill" />
                                        </Border>

                                        <!-- NO gesture recognizers on the header content ON PURPOSE.
                                             A TapGestureRecognizer here would make the native child
                                             view consume the whole touch stream, so swipes that
                                             start on the title would never reach HeaderDragZone's
                                             pan recognizer (expand / collapse / close / track
                                             carousel would all be dead over the text). Instead the
                                             header's single TapGestureRecognizer fires only for
                                             genuine clicks (Android touch-slop semantics) and the
                                             code-behind hit-tests the click against TrackTitleLabel:
                                             the TITLE line only, and only its rendered text extent.
                                             The artist line below it and the empty strip right of
                                             the text deliberately do nothing. -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <views:AutoMarqueeLabel x:Name="TrackTitleLabel" Text="{Binding CurrentTrack.Title}" TextColor="{DynamicResource TitleColor}" FontSize="16" FontAttributes="Bold" />
                                                <views:AutoMarqueeLabel Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown Artist'}" TextColor="{DynamicResource MutedColor}" FontSize="13" />
                                        </VerticalStackLayout>

                                        <!-- Controls Container. The skip button was removed - swipe
                                             left/right on the mini header now switches tracks, so only
                                             the play/pause button (40px) lives here. -->
                                        <Grid x:Name="HeaderRightControls" Grid.Column="2" WidthRequest="40" VerticalOptions="Center" HorizontalOptions="End" IsClippedToBounds="True">

                                                <!-- Mini Controls -->
                                                <HorizontalStackLayout x:Name="MiniControls" Spacing="4" HorizontalOptions="End">
                                                        <Grid WidthRequest="40" HeightRequest="40">
                                                                <ImageButton Source="{Binding PlayPauseIcon}" Command="{Binding TogglePlayCommand}" BackgroundColor="Transparent" Padding="8" CornerRadius="20"/>

                                                                <Border Background="{DynamicResource SurfaceScrimPanel}" StrokeThickness="0" IsVisible="{Binding IsLoadingMedia}">
                                                                        <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="20" />
                                                                        </Border.StrokeShape>
                                                                        <ActivityIndicator IsRunning="{Binding IsLoadingMedia}" Color="{DynamicResource AccentColor}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                                                </Border>
                                                        </Grid>
                                                </HorizontalStackLayout>

                                                <!-- Expanded Header Controls (Overlapping Grid to save horizontal space) -->
                                                <Grid x:Name="ExpandedHeaderControls" HorizontalOptions="End" IsVisible="False" Opacity="0">

                                                        <!-- Track Options Button (visible in BOTH medium and full states) -->
                                                        <ImageButton x:Name="TrackOptionsBtn"
                                                                                 Source="ellipsis_vertical_icon.png" 
                                                                                 Clicked="OnCurrentTrackOptionsClicked" 
                                                                                 WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" Padding="8" CornerRadius="20" />
                                                </Grid>

                                        </Grid>
                                </Grid>

                                <!-- Swipe preview pages (mini state): sliding the header LEFT
                                     reveals the NEXT track (from the right edge), sliding RIGHT
                                     reveals the PREVIOUS track (from the left edge). They are full
                                     visual clones of the header page, data-driven from code-behind,
                                     so the current and the neighbor track are visible together
                                     during the swipe - like the pages were always there.
                                     Never interactive (InputTransparent) and hidden when idle. -->
                                <Grid x:Name="PrevTrackPage"
                                      ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12"
                                      Margin="16,14,16,14" IsVisible="False" InputTransparent="True">
                                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="7" />
                                                </Border.StrokeShape>
                                                <Image x:Name="PrevTrackImage" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <views:AutoMarqueeLabel x:Name="PrevTrackTitle" TextColor="{DynamicResource TitleColor}" FontSize="16" FontAttributes="Bold" />
                                                <views:AutoMarqueeLabel x:Name="PrevTrackArtist" TextColor="{DynamicResource MutedColor}" FontSize="13" />
                                        </VerticalStackLayout>
                                        <ImageButton Grid.Column="2" Source="{Binding PlayPauseIcon}" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" Padding="8" CornerRadius="20" VerticalOptions="Center" />
                                </Grid>

                                <Grid x:Name="NextTrackPage"
                                      ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12"
                                      Margin="16,14,16,14" IsVisible="False" InputTransparent="True">
                                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="7" />
                                                </Border.StrokeShape>
                                                <Image x:Name="NextTrackImage" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <views:AutoMarqueeLabel x:Name="NextTrackTitle" TextColor="{DynamicResource TitleColor}" FontSize="16" FontAttributes="Bold" />
                                                <views:AutoMarqueeLabel x:Name="NextTrackArtist" TextColor="{DynamicResource MutedColor}" FontSize="13" />
                                        </VerticalStackLayout>
                                        <ImageButton Grid.Column="2" Source="{Binding PlayPauseIcon}" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" Padding="8" CornerRadius="20" VerticalOptions="Center" />
                                </Grid>
                        </Grid>

                        <!-- ========================================== -->
                        <!-- 3. BOTTOM PROGRESS BAR (purely visual playback
                             position indicator on the pane's very bottom edge.
                             Non-interactive: InputTransparent passes taps through
                             to the pane, no gestures attached, no time text.
                             Track = BorderColor, fill = AccentColor; the fill's
                             width is set from the ViewModel in code-behind) -->
                        <!-- ========================================== -->
                        <Grid x:Name="BottomProgressBar"
                              VerticalOptions="End"
                              HeightRequest="3"
                              BackgroundColor="{DynamicResource BorderColor}"
                              InputTransparent="True">
                                <BoxView x:Name="BottomProgressFill"
                                         Color="{DynamicResource AccentColor}"
                                         HorizontalOptions="Start"
                                         WidthRequest="0" />
                        </Grid>
                </Grid>
        </Border>
</ContentView>
