<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Musicthingy.Views.MobilePlayerPaneView"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:Musicthingy.Models"
             xmlns:views="clr-namespace:Musicthingy.Views">

    <Border x:Name="PlayerRoot" 
            Background="{DynamicResource CardColor}" 
            Stroke="{DynamicResource BorderColor}" 
            StrokeThickness="1" 
            Margin="-1,0,0,-2"
            Padding="0"
            VerticalOptions="End"
            HeightRequest="72"
            IsVisible="{Binding IsMediaSelected}">

        <Border.GestureRecognizers>
            <TapGestureRecognizer />
        </Border.GestureRecognizers>

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16,16,0,0" />
        </Border.StrokeShape>

        <!-- NO RowDefinitions. They overlap and are manually pushed down by TranslationY -->
        <Grid BackgroundColor="Transparent">

            <!-- ========================================== -->
            <!-- 2. EXPANDED ZONE (Moved above HeaderDragZone so it draws Underneath it, VerticalOptions=Start allows it to clip offscreen) -->
            <!-- ========================================== -->
            <Grid x:Name="ExpandedContentZone" VerticalOptions="Start" Padding="16,10,16,16" IsVisible="False" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <VerticalStackLayout Grid.Row="0" Spacing="16" Margin="0,0,0,10">

                    <!-- Tags -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,10">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CurrentTrack.Tags}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="6,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding .}" TextColor="{DynamicResource TagTextColor}" FontSize="10"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Progress Bar -->
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Margin="0,0,0,4">
                        <Label Grid.Column="0" Text="{Binding CurrentPosition, StringFormat='{0:mm\\:ss}'}" TextColor="{DynamicResource MutedColor}" FontSize="11" VerticalOptions="Center" MinimumWidthRequest="35"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                                DragStartedCommand="{Binding DragStartedCommand}" DragCompletedCommand="{Binding SeekCommand}"
                                MinimumTrackColor="{DynamicResource AccentColor}" MaximumTrackColor="{DynamicResource BorderColor}" ThumbColor="{DynamicResource TitleColor}" VerticalOptions="Center" Margin="0,-6,0,-6"/>
                        <Label Grid.Column="2" Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}" TextColor="{DynamicResource MutedColor}" FontSize="11" VerticalOptions="Center" MinimumWidthRequest="35"/>
                    </Grid>

                    <!-- Main Transport Controls -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="24" Margin="0,8,0,0">

                        <ImageButton x:Name="ShuffleBtn" 
                            Source="{Binding ShuffleIconSource}" 
                            Command="{Binding ToggleShuffleCommand}" 
                            BackgroundColor="Transparent" 
                            CornerRadius="18" WidthRequest="36" HeightRequest="36" Padding="8">
                            <ImageButton.Behaviors>
                                <toolkit:IconTintColorBehavior BindingContext="{Binding BindingContext, Source={x:Reference ShuffleBtn}}" TintColor="{Binding ShuffleIconColor}" />
                            </ImageButton.Behaviors>
                        </ImageButton>

                        <ImageButton Source="skip_back_icon.png" Command="{Binding PlayPreviousCommand}" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" Padding="10" CornerRadius="22" />

                        <Border Background="{DynamicResource CardHoverColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" WidthRequest="56" HeightRequest="56">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>

                            <Grid>
                                <ImageButton Source="{Binding PlayPauseIcon}" Command="{Binding TogglePlayCommand}" WidthRequest="56" HeightRequest="56" BackgroundColor="Transparent" Padding="14"/>

                                <Grid BackgroundColor="{DynamicResource SurfaceScrimPanel}" IsVisible="{Binding IsLoadingMedia}">
                                    <ActivityIndicator IsRunning="{Binding IsLoadingMedia}" Color="{DynamicResource AccentColor}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <ImageButton Source="skip_forward_icon.png" Command="{Binding PlayNextCommand}" WidthRequest="44" HeightRequest="44" BackgroundColor="Transparent" Padding="10" CornerRadius="22"/>

                        <ImageButton x:Name="RepeatBtn" 
                            Source="{Binding RepeatIconSource}" 
                            Command="{Binding ToggleRepeatCommand}" 
                            BackgroundColor="Transparent" 
                            CornerRadius="18" WidthRequest="36" HeightRequest="36" Padding="8">
                            <ImageButton.Behaviors>
                                <toolkit:IconTintColorBehavior BindingContext="{Binding BindingContext, Source={x:Reference RepeatBtn}}" TintColor="{Binding RepeatIconColor}" />
                            </ImageButton.Behaviors>
                        </ImageButton>

                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Lyrics & No-Lyrics Zone -->
                <Grid x:Name="LyricsScrollView" Grid.Row="1" Margin="0,20,0,0">

                    <CollectionView x:Name="LyricsCollectionView" ItemsSource="{Binding ActiveTimedLyrics}" SelectionMode="None" IsVisible="{Binding HasTimedLyrics}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TimedLyric">
                                <Label Text="{Binding Text}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" LineHeight="1.4" Margin="10,6,10,6">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceInverse}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                            <Setter Property="FontSize" Value="22" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource MutedColor}" />
                                            <Setter Property="FontAttributes" Value="None" />
                                            <Setter Property="FontSize" Value="18" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <BoxView HeightRequest="120" BackgroundColor="Transparent"/>
                        </CollectionView.Footer>
                    </CollectionView>

                    <ScrollView VerticalOptions="Fill" IsVisible="{Binding HasStaticLyrics}">
                        <Label Text="{Binding CurrentTrack.Lyrics}" 
                               TextColor="{DynamicResource TextColor}" 
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center" 
                               VerticalOptions="Start" 
                               Margin="10,0,10,40" 
                               FontSize="18" 
                               LineHeight="1.4"/>
                    </ScrollView>

                    <!-- Prompt to Find Lyrics -->
                    <ContentView IsVisible="{Binding HasNoLyrics}">
                        <VerticalStackLayout x:Name="NoLyricsPrompt" VerticalOptions="Center" Spacing="16" IsVisible="False" Opacity="0">
                            <Label Text="No lyrics available for this track." TextColor="{DynamicResource MutedColor}" HorizontalOptions="Center" />

                            <Button Text="Find Lyrics" Command="{Binding FindLyricsCommand}" 
                                    BackgroundColor="{DynamicResource SurfaceRaised}" TextColor="{DynamicResource AccentColor}" CornerRadius="8" WidthRequest="160" HorizontalOptions="Center">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFetchingLyrics}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Text" Value="Searching..." />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <ActivityIndicator IsRunning="True" Color="{DynamicResource AccentColor}" WidthRequest="24" HeightRequest="24" IsVisible="{Binding IsFetchingLyrics}"/>
                        </VerticalStackLayout>
                    </ContentView>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- 1. DRAG ZONE (VerticalOptions=Start locks the height and acts freely over the List bounds) -->
            <!-- ========================================== -->
            <Grid x:Name="HeaderDragZone" BackgroundColor="Transparent" Padding="0" VerticalOptions="Start">

                <RoundRectangle x:Name="DragHandle" 
                                Fill="{DynamicResource DragHandleColor}" WidthRequest="36" HeightRequest="5" 
                                CornerRadius="2.5" HorizontalOptions="Center" VerticalOptions="Start"
                                Margin="0,12,0,0" IsVisible="False" Opacity="0" />

                <Grid x:Name="HeaderContentGrid" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Margin="12,14,12,14">

                    <Border x:Name="TrackImageBorder" Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Image Source="{Binding CurrentTrack.ItemIconSource}" Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <views:AutoMarqueeLabel Text="{Binding CurrentTrack.Title}" TextColor="{DynamicResource TitleColor}" FontSize="16" FontAttributes="Bold" />
                        <views:AutoMarqueeLabel Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown Artist'}" TextColor="{DynamicResource MutedColor}" FontSize="13" />
                    </VerticalStackLayout>

                    <!-- Mini Controls -->
                    <HorizontalStackLayout x:Name="MiniControls" Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                        <Grid WidthRequest="40" HeightRequest="40">
                            <ImageButton Source="{Binding PlayPauseIcon}" Command="{Binding TogglePlayCommand}" BackgroundColor="Transparent" Padding="8" CornerRadius="20"/>

                            <Border Background="{DynamicResource SurfaceScrimPanel}" StrokeThickness="0" IsVisible="{Binding IsLoadingMedia}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <ActivityIndicator IsRunning="{Binding IsLoadingMedia}" Color="{DynamicResource AccentColor}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <ImageButton Source="skip_forward_icon.png" Command="{Binding PlayNextCommand}" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" Padding="8" CornerRadius="20"/>
                    </HorizontalStackLayout>

                    <!-- Expanded Header Controls -->
                    <HorizontalStackLayout x:Name="ExpandedHeaderControls" Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="End" IsVisible="False" Opacity="0">
                        <ImageButton x:Name="AutoFollowBtn" 
                                     Source="{Binding AutoFollowIconSource}" 
                                     Command="{Binding ToggleAutoFollowCommand}" 
                                     WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" Padding="8" CornerRadius="20">
                            <ImageButton.Behaviors>
                                <toolkit:IconTintColorBehavior BindingContext="{Binding BindingContext, Source={x:Reference AutoFollowBtn}}" 
                                                               TintColor="{Binding AutoFollowIconColor}" />
                            </ImageButton.Behaviors>
                        </ImageButton>
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>
