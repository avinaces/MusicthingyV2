<?xml version="1.0" encoding="utf-8" ?>
<resources xmlns:tools="http://schemas.android.com/tools">
	<!--
      Change the parent to Theme.Material3.DayNight.NoActionBar. 
      If it currently says Theme.MaterialComponents..., M3 will fallback to purple.
    -->
	<style name="Maui.MainTheme.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
		<!-- Standard Android attributes -->
		<item name="colorPrimary">@color/colorPrimary</item>
		<item name="colorPrimaryDark">@color/colorPrimaryDark</item>
		<item name="colorAccent">@color/colorAccent</item>

		<!-- Material 3 specific attributes (This is what the M3 Entry underlines/labels use) -->
		<item name="colorSecondary">@color/colorAccent</item>
		<item name="colorPrimaryContainer">@color/colorPrimary</item>
		<item name="colorSecondaryContainer">@color/colorAccent</item>

		<!-- Optional: fixes text selection/cursor color to match your accent -->
		<item name="colorControlActivated">@color/colorAccent</item>
		<item name="colorControlHighlight">@color/colorAccent</item>

		<!-- Dark-only app: white status/nav bar icons on every device, and no
		     OEM "force dark" inversion of the already dark surfaces. This theme
		     is the post-splash theme, so it covers the whole app lifetime. -->
		<item name="android:windowLightStatusBar">false</item>
		<item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
		<item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
	</style>
</resources>