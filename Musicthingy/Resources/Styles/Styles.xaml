	<Style TargetType="Page" ApplyToDerivedTypes="True">
		<Setter Property="Padding" Value="0"/>
		<Setter Property="BackgroundColor" Value="{DynamicResource BgColor}" />
	</Style>

	<Style TargetType="Shell" ApplyToDerivedTypes="True">
		<Setter Property="Shell.BackgroundColor" Value="{DynamicResource BgColor}" />
		<Setter Property="Shell.ForegroundColor" Value="{DynamicResource TextColor}" />
		<Setter Property="Shell.TitleColor" Value="{DynamicResource TitleColor}" />
		<Setter Property="Shell.DisabledColor" Value="{DynamicResource MutedColor}" />
		<Setter Property="Shell.UnselectedColor" Value="{DynamicResource MutedColor}" />
		<Setter Property="Shell.NavBarHasShadow" Value="False" />
		<Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource CardColor}" />
		<Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource AccentColor}" />
		<Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource AccentColor}" />
		<Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource MutedColor}" />
	</Style>

	<Style TargetType="NavigationPage">
		<Setter Property="BarBackgroundColor" Value="{DynamicResource BgColor}" />
		<Setter Property="BarTextColor" Value="{DynamicResource TitleColor}" />
		<Setter Property="IconColor" Value="{DynamicResource TitleColor}" />
	</Style>

	<Style TargetType="TabbedPage">
		<Setter Property="BarBackgroundColor" Value="{DynamicResource BgColor}" />
		<Setter Property="BarTextColor" Value="{DynamicResource AccentColor}" />
		<Setter Property="UnselectedTabColor" Value="{DynamicResource MutedColor}" />
		<Setter Property="SelectedTabColor" Value="{DynamicResource TitleColor}" />
	</Style>

	<!-- Popup Form Styles -->
	<Style x:Key="FormLabelStyle" TargetType="Label">
		<Setter Property="TextColor" Value="{DynamicResource MutedColor}" />
		<Setter Property="FontSize" Value="12" />
	</Style>

	<Style x:Key="FormEntryStyle" TargetType="Entry">
		<Setter Property="TextColor" Value="{DynamicResource TextColor}" />
		<Setter Property="BackgroundColor" Value="{DynamicResource SurfaceInput}" />
		<Setter Property="HeightRequest" Value="40" />

		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style x:Key="PopupSecondaryButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
		<Setter Property="TextColor" Value="{DynamicResource TextColor}" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="HeightRequest" Value="36" />
		<Setter Property="MinimumHeightRequest" Value="36" />
		<Setter Property="FontSize" Value="14" />

		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
	</Style>

	<Style x:Key="PopupPrimaryButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{DynamicResource AccentFill}" />
		<Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="HeightRequest" Value="36" />
		<Setter Property="MinimumHeightRequest" Value="36" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontAttributes" Value="Bold" />

	</Style>

</ResourceDictionary>
