<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="White">#FAFAFA</Color>
    <Color x:Key="Black">#0A0A0A</Color>

    <!-- 
        Neutral surface ramp
        FIXED: Heavily desaturated. These are now sleek, dark charcoal grays 
        with just a microscopic 2% tint, preventing "muddy" backgrounds 
        on warm themes and allowing the accents to pop.
    -->
    <Color x:Key="SurfaceCanvas">#111214</Color>
    <Color x:Key="SurfaceInput">#131417</Color>
    <Color x:Key="SurfacePanel">#18191C</Color>
    <Color x:Key="SurfacePanelHover">#1D1F23</Color>
    <Color x:Key="SurfaceRaised">#232529</Color>

    <!-- Selected surfaces retain slightly more tint for visibility -->
    <Color x:Key="SurfaceSelected">#214979</Color>
    <Color x:Key="SurfaceSelectedStrong">#344456</Color>

    <Color x:Key="SurfaceScrim">#050506</Color>
    <Color x:Key="ModalSurfaceScrim">#8C050506</Color>
    <Color x:Key="SurfaceScrimStrong">#020202</Color>
    <Color x:Key="SurfaceScrimPanel">#16171A</Color>

    <!-- Content colors (Slightly desaturated to match the new sleek backgrounds) -->
    <Color x:Key="OnSurface">#D6D8DB</Color>
    <Color x:Key="OnSurfaceMuted">#989C9F</Color>
    <Color x:Key="OnSurfaceStrong">#C8D1D9</Color>
    <Color x:Key="OnSurfaceInverse">#F8F9FA</Color>
    <Color x:Key="Outline">#373A3F</Color>
    <Color x:Key="InputOutline">#5E6267</Color>
    <Color x:Key="OutlineStrong">#5E6267</Color>
    <Color x:Key="DragHandleColor">#4D5156</Color>

    <!-- 
        Accent roles 
        Left perfectly vibrant! Since the backgrounds are now neutral, 
        these colors will punch through the screen on every theme.
    -->
    <Color x:Key="Accent">#6EA0D6</Color>
    <Color x:Key="AccentFill">#254866</Color>
    <Color x:Key="AccentFillHover">#3B6F9E</Color>
    <Color x:Key="AccentOutline">#4F7EAE</Color>
    <Color x:Key="AccentContainer">#1C304A</Color>
    <Color x:Key="OnAccent">#F8FBFF</Color>
    <Color x:Key="OnAccentContainer">#D9EDFF</Color>

    <!-- Danger states (Typically remain red, excluded from theming) -->
    <Color x:Key="DangerLight">#F2B8B5</Color>
    <Color x:Key="Danger">#D86A73</Color>
    <Color x:Key="DangerFill">#74313A</Color>
    <Color x:Key="DangerFillHover">#8A3A44</Color>
    <Color x:Key="OnDanger">#F8FBFF</Color>

    <!-- Compatibility aliases -->
    <Color x:Key="Primary">#315F88</Color>
    <Color x:Key="PrimaryDark">#86B4E4</Color>
    <Color x:Key="PrimaryDarkText">#111214</Color>
    <Color x:Key="Secondary">#2B323B</Color>
    <Color x:Key="SecondaryDarkText">#9DBBD8</Color>
    <Color x:Key="Tertiary">#4F7EAE</Color>
    <Color x:Key="Magenta">#6EA0D6</Color>
    <Color x:Key="MidnightBlue">#111214</Color>
    <Color x:Key="OffBlack">#111214</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Legacy aliases -->
    <Color x:Key="BgColor">#111214</Color>
    <Color x:Key="CardColor">#18191C</Color>
    <Color x:Key="CardHoverColor">#1D1F23</Color>
    <Color x:Key="AccentColor">#6EA0D6</Color>
    <Color x:Key="SelectedBgColor">#2B323B</Color>
    <Color x:Key="DangerColor">#74313A</Color>
    <Color x:Key="TitleColor">#C8D1D9</Color>
    <Color x:Key="MutedColor">#989C9F</Color>
    <Color x:Key="TextColor">#D6D8DB</Color>
    <Color x:Key="BorderColor">#373A3F</Color>
    <Color x:Key="InputBorderColor">#5E6267</Color>
    <Color x:Key="TagBgColor">#1C304A</Color>
    <Color x:Key="TagTextColor">#D9EDFF</Color>
    <Color x:Key="TabIndicatorColor">#232529</Color>
    <Color x:Key="IconSelectedColor">#adcff0</Color>

    <Color x:Key="SwipeEditColor">#315F88</Color>
    <Color x:Key="SwipeDeleteColor">#74313A</Color>

    <!-- Button Colors -->

    <!-- Primary Button (Material Design Dark Mode Standard) -->
    <!-- The background is a light, desaturated version of the accent (Tone 80) -->
    <Color x:Key="PrimaryButtonColor">#A6C8FF</Color>
    <!-- The text/icon is a very dark version of the accent (Tone 20) -->
    <Color x:Key="PrimaryButtonText">#003060</Color>
    <!-- Border matches the background -->
    <Color x:Key="PrimaryButtonBorder">#A6C8FF</Color>

    <!-- Secondary Button (Matches Card/Neutral roles) -->
    <!-- Soft, dark surface color -->
    <Color x:Key="SecondaryButtonColor">#18191C</Color>
    <!-- Light, muted text -->
    <Color x:Key="SecondaryButtonText">#D6D8DB</Color>
    <!-- Slightly lighter border to define the shape -->
    <Color x:Key="SecondaryButtonBorder">#373A3F</Color>
</ResourceDictionary>