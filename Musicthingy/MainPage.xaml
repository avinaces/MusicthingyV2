<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:models="clr-namespace:Musicthingy.Models"
			 x:Class="Musicthingy.MainPage"
			 BackgroundColor="{DynamicResource BgColor}"
			 xmlns:views="clr-namespace:Musicthingy.Views">

    <Grid ColumnDefinitions="220, *, 350" Padding="16" ColumnSpacing="16">

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" RowDefinitions="Auto, Auto" RowSpacing="12" Margin="0,0,0,16">
                    <Label Grid.Row="0" Text="Playlists" TextColor="{DynamicResource TitleColor}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="Center">
                        <ImageButton Source="upload_icon.png" Style="{StaticResource IconImageButton}" />
                        <ImageButton Source="download_icon.png" Command="{Binding ImportPlaylistCommand}" Style="{StaticResource IconImageButton}" />
                        <ImageButton Source="plus_icon.png" Command="{Binding AddNewPlaylistCommand}" Style="{StaticResource IconImageButton}" />
                        <ImageButton Source="maximize_2_icon.png" Style="{StaticResource IconImageButton}" />
                    </HorizontalStackLayout>
                    <BoxView Grid.Row="1" HeightRequest="1" Color="{DynamicResource BorderColor}" VerticalOptions="End" Margin="0,0,0,-8" />
                </Grid>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" SelectionMode="Single" ItemSizingStrategy="MeasureFirstItem">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <Grid Margin="0,0,0,6">

                                <!-- Layer 1: Background with DataTrigger instead of VSM -->
                                <Border x:Name="RootBorder" StrokeShape="RoundRectangle 12" Padding="0" Background="{DynamicResource CardHoverColor}" Stroke="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SelectedBgColor}" />
                                            <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Layer 2: Content (No input blockers) -->
                                <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="0" Padding="8">
                                    <Image Grid.Row="0" Source="{Binding IconImageSource}" Aspect="AspectFill" HeightRequest="110" WidthRequest="110" HorizontalOptions="Center" Margin="0,0,0,4">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="12" Rect="0,0,110,110" />
                                        </Image.Clip>
                                    </Image>

                                    <Label Grid.Row="1" Text="{Binding Name}" HorizontalTextAlignment="Center" FontSize="14" FontAttributes="Bold" />

                                    <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="6">
                                        <Border Background="{DynamicResource SurfaceInput}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="8,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ItemCount, StringFormat='{0} tracks'}" TextColor="{DynamicResource MutedColor}" FontSize="10" />
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceInput}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="8,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding DisplayDuration}" TextColor="{DynamicResource MutedColor}" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="NoWrap"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="3" Text="{Binding CreatedAt, StringFormat='CREATED {0:MMM dd, yyyy, hh:mm tt}'}" HorizontalTextAlignment="Center" TextColor="{DynamicResource MutedColor}" FontSize="9" CharacterSpacing="0.5" TextTransform="Uppercase" Margin="0,4,0,0" />
                                </Grid>

                                <!-- Layer 3: Desktop Hover Catcher & Action Buttons -->
                                <Grid BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <PointerGestureRecognizer PointerEnteredCommand="{Binding PointerEnteredCommand}" PointerExitedCommand="{Binding PointerExitedCommand}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Hover Tint -->
                                    <Border BackgroundColor="{DynamicResource OnSurfaceInverse}" Opacity="0" InputTransparent="True" StrokeShape="RoundRectangle 12" Stroke="Transparent">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsHovered}" Value="True">
                                                <Setter Property="Opacity" Value="0.06" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>

                                    <!-- DESKTOP ACTION BUTTONS (Top Center) -->
                                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Spacing="8" Margin="0,16,0,0" Opacity="0">
                                        <HorizontalStackLayout.Triggers>
                                            <!-- MultiTrigger: Only shows when the playlist is BOTH Selected AND Hovered over -->
                                            <MultiTrigger TargetType="HorizontalStackLayout">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                    <BindingCondition Binding="{Binding IsHovered}" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Opacity" Value="1" />
                                            </MultiTrigger>
                                        </HorizontalStackLayout.Triggers>

                                        <ImageButton Source="pencil_icon.png" Style="{StaticResource IconImageButton}" WidthRequest="36" HeightRequest="36" Padding="6" />
                                        <ImageButton Source="trash_2_icon.png" BackgroundColor="{DynamicResource DangerColor}" BorderColor="Transparent" CornerRadius="8" WidthRequest="37" HeightRequest="37" Padding="6" Command="{Binding BindingContext.DeletePlaylistCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{DynamicResource DangerFillHover}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </VisualStateManager.VisualStateGroups>
                                        </ImageButton>

                                    </HorizontalStackLayout>
                                </Grid>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                    <Label Grid.Column="0" Text="{Binding SelectedPlaylist.Name, FallbackValue='Select a Playlist'}" TextColor="{DynamicResource TitleColor}" FontSize="24" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding SelectedPlaylist.ItemCount, StringFormat='{0} items'}" TextColor="{DynamicResource MutedColor}" FontSize="13" HorizontalOptions="End"/>
                            <Label Text="{Binding SelectedPlaylist.DisplayDuration}" TextColor="{DynamicResource MutedColor}" FontSize="13" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                        <ImageButton Source="settings_icon.png" Style="{StaticResource IconImageButton}" />
                    </HorizontalStackLayout>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,0,0,16" HeightRequest="44">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                        <ImageButton Source="play_icon.png" Command="{Binding PlayPlaylistCommand}" Style="{StaticResource IconImageButton}" />
                        <ImageButton Source="shuffle_icon.png" Command="{Binding ShufflePlaylistCommand}"  Style="{StaticResource IconImageButton}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">
                        <ImageButton Source="plus_icon.png" Style="{StaticResource IconImageButton}" />
                        <ImageButton Source="clipboard_icon.png" Style="{StaticResource IconImageButton}" />
                        <ImageButton Source="list_icon.png" Style="{StaticResource IconImageButton}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- LIST ITEMS -->
                <CollectionView Grid.Row="2" ItemsSource="{Binding SelectedPlaylist.Items}" SelectedItem="{Binding CurrentTrack, Mode=TwoWay}" SelectionMode="Single" ItemSizingStrategy="MeasureFirstItem">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlaylistItem">
                            <Grid Margin="0,0,0,4" HeightRequest="58">

                                <!-- Layer 1: Background with DataTrigger instead of VSM -->
                                <Border x:Name="RootBorder" StrokeShape="RoundRectangle 8" Padding="0" Background="{DynamicResource CardHoverColor}" Stroke="{DynamicResource BorderColor}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceSelected}" />
                                            <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Layer 2: Content Grid -->
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Padding="10">
                                    <Grid Grid.Column="0" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                        <Image Source="{Binding ItemIconSource}" Aspect="AspectFill">
                                            <Image.Clip>
                                                <RoundRectangleGeometry CornerRadius="6" Rect="0,0,36,36" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">

                                        <Label Grid.Row="0"
											Text="{Binding Title}"
											FontSize="15"
											FontAttributes="Bold"
											LineBreakMode="TailTruncation" />

                                        <!-- Clipping container -->
                                        <Grid HeightRequest="24" IsClippedToBounds="True">

                                            <FlexLayout Grid.Row="1"
												Direction="Row"
												Wrap="NoWrap"
												AlignItems="Center"
												IsVisible="{Binding HasTags}">

                                                <!-- Tags -->
                                                <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag1}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Tag1}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                </Border>

                                                <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag2}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Tag2}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                </Border>

                                                <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag3}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Tag3}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                </Border>

                                                <Border Background="{DynamicResource TagBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="5,1" Margin="0,0,1,1" IsVisible="{Binding HasTag4}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Tag4}" TextColor="{DynamicResource TagTextColor}" FontSize="11"/>
                                                </Border>

                                            </FlexLayout>

                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Layer 3: Desktop Hover & Interaction Overlay -->
                                <Grid BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <PointerGestureRecognizer PointerEnteredCommand="{Binding PointerEnteredCommand}" PointerExitedCommand="{Binding PointerExitedCommand}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Hover Tint -->
                                    <Border BackgroundColor="{DynamicResource OnSurfaceInverse}" Opacity="0" InputTransparent="True" StrokeShape="RoundRectangle 8" Stroke="Transparent">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsHovered}" Value="True">
                                                <Setter Property="Opacity" Value="0.08" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>

                                    <!-- DESKTOP ACTION BUTTONS -->
                                    <!-- Rendered directly inside the Desktop overlay so they don't break the hover events when clicked -->
                                    <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="6" Margin="10" Opacity="0">
                                        <HorizontalStackLayout.Triggers>
                                            <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding IsHovered}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </HorizontalStackLayout.Triggers>

                                        <ImageButton Source="pencil_icon.png" Style="{StaticResource IconImageButton}"
			 Command="{Binding BindingContext.EditTrackCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
			 CommandParameter="{Binding .}"/>

                                        <ImageButton Source="trash_2_icon.png" Style="{StaticResource IconImageButton}" BackgroundColor="{DynamicResource DangerColor}"
			 Command="{Binding BindingContext.DeleteTrackCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
			 CommandParameter="{Binding .}">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{DynamicResource DangerFillHover}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </VisualStateManager.VisualStateGroups>
                                        </ImageButton>
                                    </HorizontalStackLayout>
                                </Grid>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Border>

        <views:PlayerPaneView Grid.Column="2" />

        <!-- MODAL OVERLAY -->
        <Grid Grid.ColumnSpan="3" IsVisible="{Binding IsModalVisible}" ZIndex="100">

            <!-- Dimmed Background Catcher -->
            <BoxView BackgroundColor="{DynamicResource SurfaceScrim}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ModalBackgroundTappedCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Modal Window -->
            <Border Background="{DynamicResource CardColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="400" Padding="24">
                <VerticalStackLayout Spacing="16">

                    <Label Text="{Binding ModalTitle}" TextColor="{DynamicResource TitleColor}" FontSize="20" FontAttributes="Bold" />

                    <Label Text="{Binding ModalMessage}" TextColor="{DynamicResource TextColor}" IsVisible="{Binding IsModalMessageVisible}" />

                    <Entry Text="{Binding ModalInputText}" Style="{StaticResource FormEntryStyle}" IsVisible="{Binding IsModalInputVisible}" Placeholder="Type here..." />

                    <!-- Buttons -->
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,8,0,0">
                        <Button Text="Cancel" Command="{Binding ModalCancelCommand}" Style="{StaticResource PopupSecondaryButtonStyle}" />
                        <Button Text="{Binding ModalConfirmText}" Command="{Binding ModalConfirmCommand}" Style="{StaticResource PopupPrimaryButtonStyle}" BackgroundColor="{Binding ModalConfirmColor}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
