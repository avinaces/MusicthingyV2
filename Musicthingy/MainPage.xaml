<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Musicthingy.Models"
             x:Class="Musicthingy.MainPage"
             BackgroundColor="{StaticResource BgColor}">

    <ContentPage.Resources>
        <Color x:Key="BgColor">#0d1117</Color>
        <Color x:Key="CardColor">#161b22</Color>
        <Color x:Key="AccentColor">#58a6ff</Color>
        <Color x:Key="TitleColor">#adcff0</Color>
        <Color x:Key="MutedColor">#8b949e</Color>
        <Color x:Key="TextColor">#c9d1d9</Color>
        <Color x:Key="BorderColor">#30363d</Color>

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextColor}" />
            <Setter Property="FontFamily" Value="Roboto" />
        </Style>

        <Style x:Key="IconImageButton" TargetType="ImageButton">
            <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="WidthRequest" Value="32" />
            <!-- Slightly smaller to match HTML -->
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderWidth" Value="1" />
            <Style.Triggers>
                <Trigger TargetType="ImageButton" Property="IsPressed" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource BorderColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <!-- Shrunk Sidebar to 240px -->
    <Grid ColumnDefinitions="240, *" Padding="12" ColumnSpacing="16">

        <!-- SIDEBAR -->
        <Border Grid.Column="0" BackgroundColor="{StaticResource CardColor}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" RowDefinitions="Auto, Auto" RowSpacing="12" Margin="0,0,0,12">
                    <Label Grid.Row="0" Text="Playlists" TextColor="{StaticResource TitleColor}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />

                    <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="Center">
                        <ImageButton Source="upload_icon.png" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="Export" />
                        <ImageButton Source="download_icon.png" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="Import" />
                        <ImageButton Source="plus_icon.png" Command="{Binding AddNewPlaylistCommand}" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="New List" />
                    </HorizontalStackLayout>
                    <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="End" Margin="0,0,0,-8" />
                </Grid>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <Border BackgroundColor="#1c2128" Stroke="Transparent" StrokeShape="RoundRectangle 12" Margin="0,0,0,12" Padding="10">
                                <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                                    <!-- Made Image strictly square and slightly larger relative to the card -->
                                    <Image Grid.Row="0" Source="{Binding IconUrl}" Aspect="AspectFill" HeightRequest="140" WidthRequest="140" HorizontalOptions="Center" />
                                    <Label Grid.Row="1" Text="{Binding Name}" HorizontalOptions="Center" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="2" Text="{Binding ItemCount, StringFormat='{0} items'}" HorizontalOptions="Center" TextColor="{StaticResource MutedColor}" FontSize="10" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Column="1" BackgroundColor="{StaticResource CardColor}" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                    <Label Grid.Column="0" Text="Multi-List Editor" TextColor="{StaticResource TitleColor}" FontSize="20" FontAttributes="Bold" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding SelectedPlaylist.ItemCount, StringFormat='{0} items'}" TextColor="{StaticResource MutedColor}" FontSize="12" HorizontalOptions="End"/>
                            <Label Text="00:00" TextColor="{StaticResource MutedColor}" FontSize="12" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                        <ImageButton Source="settings_icon.png" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="Settings" />
                    </HorizontalStackLayout>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,0,0,16" HeightRequest="44">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                        <ImageButton Source="play_icon.png" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="Play" />
                        <ImageButton Source="shuffle_icon.png" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="Shuffle" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">
                        <ImageButton Source="plus_icon.png" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="Add Item" />
                        <ImageButton Source="clipboard_icon.png" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="Paste" />
                        <ImageButton Source="list_icon.png" Style="{StaticResource IconImageButton}" ToolTipProperties.Text="Import YT" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- LIST ITEMS (Increased Bottom Margin for Spacing) -->
                <CollectionView Grid.Row="2" ItemsSource="{Binding SelectedPlaylist.Items}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlaylistItem">

                            <!-- Increased Margin from 8 to 12 -->
                            <Border BackgroundColor="#1c2128" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12" Margin="0,0,0,12">
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEnteredCommand="{Binding PointerEnteredCommand}" PointerExitedCommand="{Binding PointerExitedCommand}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16">
                                    <!-- Increased spacing between icon and text -->

                                    <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44">
                                        <Image Source="dotnet_bot.png" Aspect="AspectFill" />

                                        <CheckBox IsChecked="{Binding IsSelected}" Color="{StaticResource AccentColor}" 
                                                  HorizontalOptions="Start" VerticalOptions="Start" Margin="0,0,0,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="CheckBox" Binding="{Binding IsHovered}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="CheckBox" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding DisplayUrl}" TextColor="{StaticResource MutedColor}" FontSize="12" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                        <HorizontalStackLayout.Style>
                                            <Style TargetType="HorizontalStackLayout">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding IsHovered}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </HorizontalStackLayout.Style>

                                        <ImageButton Source="edit_2_icon.png" BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource BorderColor}" BorderWidth="1" WidthRequest="32" HeightRequest="32" Padding="6" CornerRadius="6" />
                                        <ImageButton Source="trash_2_icon.png" BackgroundColor="{StaticResource CardColor}" BorderColor="{StaticResource BorderColor}" BorderWidth="1" WidthRequest="32" HeightRequest="32" Padding="6" CornerRadius="6" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Border>

    </Grid>
</ContentPage>